+/*
+ * Initialize a mirrored target from its surface on the GPU. This is the
+ * inverse of target_to_surface(): the IOSurface-backed mirror is read and the
+ * private texture CoreAnimation draws into is written. The target is bound.
+ * Reuse its level-0 storage when possible; allocating 11 MB again every attach
+ * would keep the cost this path is meant to remove. False selects the CPU fill.
+ */
+static bool
+surface_to_target(struct eagl *e, struct image *image)
+{
+	GLint read = 0, draw = 0;
+	GLint had_width = 0, had_height = 0, had_format = 0;
+	bool copied = false;
+
+	while (glGetError() != 0) {
+	}
+	glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, 0x1000, &had_width);
+	glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, 0x1001, &had_height);
+	glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, 0x1003, &had_format);
+	if (had_width != image->width || had_height != image->height ||
+	    had_format != (GLint)internal_format(image->internal, image->format)) {
+		glTexImage2D(image->to, 0, (GLint)internal_format(image->internal, image->format), image->width, image->height, 0,
+		    image->format, image->type, NULL);
+		if (glGetError() != 0) {
+			return false;
+		}
+	}
+
+	glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+	glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+	if (e->reader == 0) {
+		glGenFramebuffers(1, &e->reader);
+	}
+	if (e->writer == 0) {
+		glGenFramebuffers(1, &e->writer);
+	}
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, e->reader);
+	glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image->mirror, 0);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, e->writer);
+	glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image->texture, 0);
+	if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE &&
+	    glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE) {
+		glBlitFramebuffer(0, image->invert ? image->height : 0, image->width, image->invert ? 0 : image->height,
+		    0, 0, image->width, image->height, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+		copied = glGetError() == 0;
+	}
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, (GLuint)read);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, (GLuint)draw);
+	return copied;
 }
 
