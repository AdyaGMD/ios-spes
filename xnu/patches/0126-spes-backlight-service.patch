 }
 
+IOReturn
+SweetBacklight::setProperties(OSObject *properties)
+{
+	static uint32_t logged;
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (d == NULL || fFB == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (logged++ < 24) {
+		OSSerialize *ser = OSSerialize::withCapacity(256);
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET FB: backlight set by %s: %.200s\n", name, ser != NULL && d->serialize(ser) ? ser->text() : "?");
+		OSSafeReleaseNULL(ser);
+	}
+	/* A number under a key about nits or brightness, or a { value = n } under one. */
+	OSNumber *n = NULL;
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(d);
+	OSSymbol *key;
+	while (it != NULL && n == NULL && (key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+		const char *k = key->getCStringNoCopy();
+		if (strnstr(k, "nits", 64) == NULL && strnstr(k, "rightness", 64) == NULL && strcmp(k, "value") != 0) {
+			continue;
+		}
+		OSObject *v = d->getObject(key);
+		n = OSDynamicCast(OSNumber, v);
+		if (n == NULL && OSDynamicCast(OSDictionary, v) != NULL) {
+			n = OSDynamicCast(OSNumber, ((OSDictionary *)v)->getObject("value"));
+		}
+	}
+	OSSafeReleaseNULL(it);
+	if (n == NULL) {
+		return kIOReturnSuccess;
+	}
+	uint64_t v = n->unsigned64BitValue();
+	setProperty("brightness-nits", v > 0xffff ? v >> 16 : v, 32);
+	OSDictionary *level = OSDictionary::withCapacity(1);
+	OSNumber *nits = OSNumber::withNumber(v > 0xffff ? v : v << 16, 32);
+	if (level != NULL && nits != NULL) {
+		level->setObject("IOMFBBrightnessLevel", nits);
+		fFB->setProperties(level);
+	}
+	OSSafeReleaseNULL(nits);
+	OSSafeReleaseNULL(level);
+	return kIOReturnSuccess;
+}
