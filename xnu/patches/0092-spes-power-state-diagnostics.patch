+/* Khaje live FDT: RPM message RAM at 0x045f0000, 0x7000 bytes.
+ * Read-only GLINK TOC/ring inspection, as qcom_glink_rpm.c. No FIFO ownership
+ * or PMIC request is taken until the inherited bootloader state is known.
+ */
+static void
+spes_rpm_inspect(void)
+{
+	vm_offset_t ram = ml_io_map(0x045f0000u, 0x7000u);
+	if (!ram) {
+		printf("SPES RPM: mapping failed\n");
+		return;
+	}
+	uint32_t magic = touch_rd(ram, 0x6f00u);
+	uint32_t count = touch_rd(ram, 0x6f04u);
+	printf("SPES RPM: TOC magic=%#x count=%u (read-only)\n", magic, count);
+	if (magic != 0x67727430u || count > 20u) {
+		printf("SPES RPM: invalid TOC; stopping inspection\n");
+		return;
+	}
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t pos = 0x6f08u + 12u * i;
+		uint32_t id = touch_rd(ram, pos);
+		if (id != 0x61703272u && id != 0x72326170u) continue;
+		uint32_t off = touch_rd(ram, pos + 4u);
+		uint32_t size = touch_rd(ram, pos + 8u);
+		if ((off & 3u) || (size & 7u) || size < 16u ||
+		    off > 0x6f00u - 8u || size > 0x6f00u - off - 8u) {
+			printf("SPES RPM: invalid ring id=%#x off=%#x size=%#x\n", id, off, size);
+			continue;
+		}
+		uint32_t tail = touch_rd(ram, off), head = touch_rd(ram, off + 4u);
+		printf("SPES RPM: %s off=%#x size=%#x head=%#x tail=%#x valid=%d\n",
+		    id == 0x61703272u ? "TX" : "RX", off, size, head, tail,
+		    head < size && tail < size && !(head & 7u) && !(tail & 7u));
+	}
+}
+
