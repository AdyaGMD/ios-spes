+/*
+ * Direct MDP scanout (Topaz 0092/0093, same SM6225 display controller): screen-sized BGRA
+ * surfaces get physically contiguous RAM below 4 GiB, so the framebuffer can point the
+ * display pipe at a finished frame instead of copying it. At most SWEET_SCANOUT_MAX at once
+ * (CoreAnimation rotates a few; snapshots of the screen are made too); others fall back.
+ */
+#define SWEET_SCANOUT_MAX               10
+static uint32_t      sweet_scanout_w, sweet_scanout_h;  /* set by SweetFramebuffer; 0 = off */
+static SInt32        sweet_scanout_live;
+
+void
+sweet_scanout_set_geometry(uint32_t width, uint32_t height)
+{
+	sweet_scanout_w = width;
+	sweet_scanout_h = height;
+}
+
+static bool
+sweet_scanout_eligible(const SweetSurface *s)
+{
+	return sweet_scanout_w != 0 && s->width == sweet_scanout_w && s->height == sweet_scanout_h &&
+	       s->bytesPerElement == 4 && s->planeCount == 0 && s->offset == 0 &&
+	       s->elementWidth == 1 && s->elementHeight == 1 &&
+	       (s->pixelFormat == 0x42475241 /* 'BGRA' */ || s->pixelFormat == 0);
+}
+
+/* The display pipe does not snoop the processor's caches: write the lines back. */
+static void
+sweet_clean_to_memory(uintptr_t start, uint64_t size)
+{
+	for (uintptr_t line = start & ~(uintptr_t)63; line < start + size; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
