+/* With fLock held. VIG0 fetches from pa at the next vsync; s (retained here) stays alive two flips. */
+void
+AppleCLCD::scanFrom(uint64_t pa, uint32_t stride, SweetSurface *s)
+{
+	fVig0[SWEET_SSPP_SRC0_ADDR / 4] = (uint32_t)pa;
+	fVig0[SWEET_SSPP_SRC_YSTRIDE0 / 4] = stride;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fCtl0[SWEET_CTL_FLUSH / 4] = SWEET_CTL_FLUSH_VIG0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fScanPhys = pa;
+	if (s != NULL) {
+		s->retain();
+	}
+	OSSafeReleaseNULL(fScanned[1]);
+	fScanned[1] = fScanned[0];
+	fScanned[0] = s;
+}
+
+/*
+ * With fLock held, the GPU done with every layer. A frame that is one full-screen surface in
+ * contiguous memory is shown by pointing the display pipe at its panel window (Topaz 0092):
+ * no copy by the processor. Anything else (several layers, other sizes) is copied as before.
+ */
 bool
+AppleCLCD::directPresent(const uint8_t *rec, SweetSurface **surfaces)
+{
+	uint32_t mask = get32(rec, 0x104), layer = SWEET_FB_LAYERS, n = 0;
+
+	for (uint32_t i = 0; i < SWEET_FB_LAYERS; i++) {
+		if ((mask & (1u << i)) && get32(rec, 0x54 + 4 * i) != 0) {
+			layer = i;
+			n++;
+		}
+	}
+	if (n != 1 || surfaces[layer] == NULL) {
+		return false;
+	}
+	SweetSurface *s = surfaces[layer];
+	const uint8_t *a = rec + 0x64 + 16 * layer;
+	if (s->scanoutPhys == 0 || s->bytesPerElement != 4 || s->width != fLogicalW || s->height != fLogicalH ||
+	    get32(a, 0) != 0 || get32(a, 4) != 0) {
+		return false;
+	}
+	uint64_t window = (uint64_t)s->offset + (uint64_t)fOffY * s->bytesPerRow + (uint64_t)fOffX * 4;
+	uint64_t pa = s->scanoutPhys + window;
+	uintptr_t va = s->kernelAddress();
+	if (va == 0 || (pa & 0xf) != 0 || pa + (uint64_t)fHeight * s->bytesPerRow > (1ull << 32)) {
+		return false;
+	}
+	/* The MDP does not snoop CPU caches (CoreAnimation may have written some pixels itself). */
+	for (uintptr_t line = (va + window) & ~(uintptr_t)63; line < va + window + (uint64_t)fHeight * s->bytesPerRow; line += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	scanFrom(pa, s->bytesPerRow, s);
+	if (++fDirectFrames <= 4 || (fDirectFrames % 600) == 0) {
+		IOLog("SWEET FB: frame %u shown directly from surface %u at %#llx (%u copied so far)\n",
+		    fDirectFrames, s->id, pa, fCopiedFrames);
+	}
+	return true;
+}
