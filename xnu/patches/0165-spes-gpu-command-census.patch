  }
+ if(sg_census<0){uint32_t v=1;(void)PE_parse_boot_argn("spesgpucensus",&v,sizeof(v));sg_census=v!=0;}
+ if(sg_census)for(unsigned i=0;i<count;++i)spes_gpu_census(addresses[i],words[i],0);
