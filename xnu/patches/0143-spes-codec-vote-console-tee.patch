--- a/bsd/dev/arm/cons.c
+++ b/bsd/dev/arm/cons.c
@@ -75,6 +75,28 @@
 int
 cnwrite(__unused dev_t dev, struct uio *uio, int ioflag)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * A launchd job pointed at /dev/console (tools/patch-launchd-plist.py: PosterBoard, pkd)
+	 * wrote to the screen console, which sweetfb_noconsole mutes, and never reached the
+	 * persistent log. For the processes in boot-arg sweetnull it goes to the log as "|name| text",
+	 * like their /dev/null writes (bsd/dev/mem.c).
+	 */
+	extern bool sweet_console_tee(char *name, size_t len);
+	char name[32];
+	if (sweet_console_tee(name, sizeof(name))) {
+		while (uio_resid(uio) > 0) {
+			char buf[256];
+			int c = (int)MIN(uio_resid(uio), (user_ssize_t)sizeof(buf));
+			int error = uiomove(buf, c, uio);
+			if (error) {
+				return error;
+			}
+			printf("|%s| %.*s%s", name, c, buf, (c > 0 && buf[c - 1] == '\n') ? "" : "\n");
+		}
+		return 0;
+	}
+#endif
 	dev = cndev();
 	return (*cdevsw[major(dev)].d_write)(dev, uio, ioflag);
 }
