-		printf("SWEET Sandbox: %s op %d\n", name, call);
+		printf("SWEET Sandbox: %s op %d (%s)\n", name, call, call == 4 ? "answered" : "allowed");
 	}
-	switch (call) {
-	case 4:         /* container path (audit token / pid) */
-	case 5:         /* extension issue */
-	case 6:         /* extension consume */
-	case 0x43:      /* container expected */
-		return ENOENT;
-	default:
-		return 0;
-	}
+	return call == 4 ? sweet_sandbox_container_path(arg) : 0;
 }
 
