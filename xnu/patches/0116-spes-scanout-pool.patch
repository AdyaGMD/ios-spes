 /*
  * Direct MDP scanout (Topaz 0092/0093, same SM6225 display controller): screen-sized BGRA
- * surfaces get physically contiguous RAM below 4 GiB, so the framebuffer can point the
- * display pipe at a finished frame instead of copying it. At most SWEET_SCANOUT_MAX at once
- * (CoreAnimation rotates a few; snapshots of the screen are made too); others fall back.
+ * surfaces get a slot of the scanout pool (SweetSurface.h), so the framebuffer can point the
+ * display pipe at a finished frame instead of copying it. 0109 asked for contiguous kernel RAM
+ * below 4 GiB instead, which never exists on spes: no frame was ever shown directly.
+ * Mapped write-combined like the panel framebuffer (Normal memory: no Device alignment faults).
  */
-#define SWEET_SCANOUT_MAX               10
 static uint32_t      sweet_scanout_w, sweet_scanout_h;  /* set by SweetFramebuffer; 0 = off */
-static SInt32        sweet_scanout_live;
+static uint32_t      sweet_scanout_used;                /* bit per slot, under sweet_surface_lock */
+
+static int
+sweet_scanout_slot_take(void)
+{
+	int slot = -1;
+	IOLockLock(sweet_surface_lock);
+	for (int i = 0; i < SWEET_SCANOUT_SLOTS && slot < 0; i++) {
+		if (i != SWEET_SCANOUT_BLACK && !(sweet_scanout_used & (1u << i))) {
+			sweet_scanout_used |= 1u << i;
+			slot = i;
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return slot;
+}
+
+static void
+sweet_scanout_slot_give(int slot)
+{
+	IOLockLock(sweet_surface_lock);
+	sweet_scanout_used &= ~(1u << slot);
+	IOLockUnlock(sweet_surface_lock);
+}
 
 void
 sweet_scanout_set_geometry(uint32_t width, uint32_t height)
