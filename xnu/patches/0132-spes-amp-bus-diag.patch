+		/* An idle I2C line is high: a low pad means no pull-up or no bus supply. */
+		printf("SPES AMP: GPIO%u (%s) cfg %#x -> %#x, pad %s\n", pin, pin == 4 ? "SDA" : "SCL", cfg,
