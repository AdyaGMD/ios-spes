-		uint32_t cfg = amp_rd(west, pin * 0x1000u), want = (cfg & ~0x3ffu) | (1u << 2);
-		if (cfg & (1u << 11)) {
-			want |= 1u << 12;               /* EGPIO enable when present (khaje) */
+		uint32_t cfg = amp_rd(west, pin * 0x1000u);
+		if (((cfg >> 2) & 0xfu) != 1u) {
+			uint32_t want = (cfg & ~0x3cu) | (1u << 2) | 3u;   /* qup1, pull-up */
+			if (cfg & (1u << 11)) {
+				want |= 1u << 12;       /* EGPIO enable when present (khaje) */
