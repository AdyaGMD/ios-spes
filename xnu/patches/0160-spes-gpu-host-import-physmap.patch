+extern "C" vm_map_address_t phystokv(uint64_t pa);   /* osfmk/arm pmap (pmap_paddr_t = uint64_t) */
 
 /*
+ * The program's pages of a host buffer out of this processor's cache, through the kernel's map of
+ * all physical memory (the pages are wired, so their addresses hold). 0156 mapped them into the
+ * kernel instead, and that mapping failed for CoreAnimation's image memory (all37:
+ * "USERPTR ...: errno 12", "no-copy buffer refused"), so images took another upload path.
+ */
+static void
+hostPush(IOMemoryDescriptor * memory, uint64_t size)
+{
+	for (uint64_t offset = 0; offset < size;) {
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(offset, &length, kIOMemoryMapperNone);
+		if (phys == 0 || length == 0) {
+			break;
+		}
+		length = MIN(length, size - offset);
+		redwood_gpu_to_memory((void *)phystokv(phys), length);
+		offset += length;
+	}
+}
