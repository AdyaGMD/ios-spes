+/*
+ * The panel (k7_38_0c_0a, DSI video + DSC) has one timing in the DT, 90 frames a second with
+ * 2400 + 32 lines, and reaches 60 by a longer vertical front porch (qcom,dsi-supported-dfps-list
+ * 90 60, dfps_immediate_porch_mode_vfp): same clocks, more lines. Boot-arg sweetfb_rate (default
+ * 90; 0 = leave the firmware's timing): when the firmware left the long porch, the frame is cut
+ * back to rate's length in the interface and in DSI0's video engine, at the start of a frame,
+ * then measured; anything but about that rate puts the old length back. The panel's own
+ * "dispparam-bc-90hz" brightness compensation is not sent (only a colour shade, per its name).
+ */
 void
+AppleCLCD::setupRate(void)
+{
+	uint32_t want = 90;
+	(void)PE_parse_boot_argn("sweetfb_rate", &want, sizeof(want));
+	fRateHz = 60;
+	nanoseconds_to_absolutetime(SWEET_FB_VSYNC_US * 1000ull, &fFrameAbs);
+	vm_offset_t page = ml_io_map(SWEET_MDP_INTF1 & ~0xfffull, 0x1000);
+	if (page == 0) {
+		IOLog("SWEET FB: rate: no INTF_1 mapping; 60 Hz timer\n");
+		return;
+	}
+	volatile uint32_t *intf = (volatile uint32_t *)(page + (SWEET_MDP_INTF1 & 0xfff));
+	uint32_t en = intf[SWEET_INTF_EN / 4], line = intf[SWEET_INTF_HSYNC_CTL / 4] >> 16;
+	uint32_t period = intf[SWEET_INTF_VSYNC_F0 / 4];
+	uint32_t vstart = intf[SWEET_INTF_V_START / 4], vend = intf[SWEET_INTF_V_END / 4];
+	if (!(en & 1) || line == 0 || period < line || vend <= vstart) {
+		IOLog("SWEET FB: rate: INTF_1 not running (en %#x hsync %#x period %#x v %#x-%#x); 60 Hz timer\n",
+		    en, intf[SWEET_INTF_HSYNC_CTL / 4], period, vstart, vend);
+		return;
+	}
+	fIntf = intf;
+	uint32_t vtotal = period / line, active = (vend - vstart) / line + 1;
+	uint32_t dsiTotal = fDsi != NULL ? *(volatile uint32_t *)(fDsi + SWEET_DSI_VIDEO_TOTAL) : 0;
+	uint32_t mhz = measureRate(vtotal);
+	IOLog("SWEET FB: rate: panel sent %u.%03u frames/s: %u lines (%u shown), %u clocks a line; DSI total %#x\n",
+	    mhz / 1000, mhz % 1000, vtotal, active, line, dsiTotal);
+	uint32_t target = (want != 0 && mhz != 0) ? (uint32_t)((uint64_t)vtotal * mhz / (want * 1000ull)) : 0;
+	bool dsiMatches = fDsi != NULL && (dsiTotal >> 16) + 1 == vtotal;
+	if (want != 0 && mhz != 0 && mhz + 5000 < want * 1000 && target >= active + 32 && dsiMatches && fCtl0 != NULL) {
+		uint32_t oldDsi = dsiTotal;
+		while (intf[SWEET_INTF_LINE_COUNT / 4] > 64) {
+			IODelay(50);                    /* start of a frame: the change lands in the porch */
+		}
+		*(volatile uint32_t *)(fDsi + SWEET_DSI_VIDEO_TOTAL) = (dsiTotal & 0xffffu) | ((target - 1) << 16);
+		intf[SWEET_INTF_VSYNC_F0 / 4] = target * line;
+		intf[SWEET_INTF_VSYNC_F1 / 4] = target * line;
+		fCtl0[SWEET_CTL_INTF_FLUSH / 4] = 1u << 1;              /* INTF_1 */
+		fCtl0[SWEET_CTL_FLUSH / 4] = (1u << 31) | (1u << 17);   /* INTF + CTL */
+		IOSleep(50);
+		uint32_t now = measureRate(target);
+		if (now + 3000 < want * 1000 || now > want * 1000 + 3000) {
+			while (intf[SWEET_INTF_LINE_COUNT / 4] > 64) {
+				IODelay(50);
+			}
+			*(volatile uint32_t *)(fDsi + SWEET_DSI_VIDEO_TOTAL) = oldDsi;
+			intf[SWEET_INTF_VSYNC_F0 / 4] = period;
+			intf[SWEET_INTF_VSYNC_F1 / 4] = period;
+			fCtl0[SWEET_CTL_INTF_FLUSH / 4] = 1u << 1;
+			fCtl0[SWEET_CTL_FLUSH / 4] = (1u << 31) | (1u << 17);
+			IOSleep(50);
+			mhz = measureRate(vtotal);
+			IOLog("SWEET FB: rate: %u lines gave %u.%03u frames/s, not %u: old timing back (%u.%03u)\n", target,
+			    now / 1000, now % 1000, want, mhz / 1000, mhz % 1000);
+		} else {
+			vtotal = target;
+			mhz = now;
+			IOLog("SWEET FB: rate: frame cut to %u lines: %u.%03u frames/s\n", target, now / 1000, now % 1000);
+		}
+	} else if (want != 0 && mhz + 5000 < want * 1000) {
+		IOLog("SWEET FB: rate: %u Hz not set (target %u lines, active %u, DSI total %s, ctl %s)\n", want, target, active,
+		    dsiMatches ? "matches" : "differs", fCtl0 != NULL ? "mapped" : "unmapped");
+	}
+	if (mhz < 20000 || mhz > 130000) {
+		fIntf = NULL;                       /* nonsense: pace by the timer */
+		IOLog("SWEET FB: rate: measured rate unusable; 60 Hz timer\n");
+		return;
+	}
+	fVtotal = vtotal;
+	fRateHz = (mhz + 500) / 1000;
+	nanoseconds_to_absolutetime(1000000000000ull / mhz, &fFrameAbs);
+	fLineAbs = fFrameAbs / vtotal;
+	IOLog("SWEET FB: rate: vsync at the panel's frame start, %u Hz\n", fRateHz);
+}
