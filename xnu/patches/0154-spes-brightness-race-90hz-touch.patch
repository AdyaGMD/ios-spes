+/*
+ * The next vsync at the panel's next frame start: from the interface's line counter when it
+ * runs (so iOS's frame clock is the panel's, not a timer that drifts past it), else one frame
+ * after the last deadline (absolute, so the handler's own time does not stretch the period).
+ */
+void
+AppleCLCD::armVsync(IOTimerEventSource *sender)
+{
+	uint64_t now = mach_absolute_time(), next;
+	if (fIntf != NULL && fVtotal != 0 && fLineAbs != 0) {
+		uint32_t line = fIntf[SWEET_INTF_LINE_COUNT / 4];
+		uint64_t left = line < fVtotal ? (uint64_t)(fVtotal - line) * fLineAbs : fFrameAbs;
+		if (left < fFrameAbs / 4) {
+			left += fFrameAbs;              /* this frame starts too soon to be the next one */
+		}
+		next = now + left;
+	} else {
+		fNextVsync += fFrameAbs;
+		if (fNextVsync <= now) {
+			fNextVsync = now + fFrameAbs;
+		}
+		next = fNextVsync;
+	}
+	sender->wakeAtTime(next);
 }
 
+uint32_t
+AppleCLCD::measureRate(uint32_t vtotal)
+{
+	uint32_t f[2], l[2];
+	uint64_t t[2];
+	for (int i = 0; i < 2; i++) {
+		f[i] = fIntf[SWEET_INTF_FRAME_COUNT / 4];
+		l[i] = fIntf[SWEET_INTF_LINE_COUNT / 4];
+		absolutetime_to_nanoseconds(mach_absolute_time(), &t[i]);
+		if (fIntf[SWEET_INTF_FRAME_COUNT / 4] != f[i]) {
+			i--;                            /* a frame began between the reads */
+			continue;
+		}
+		if (i == 0) {
+			IOSleep(200);
+		}
+	}
+	if (vtotal == 0 || t[1] <= t[0] || f[1] == f[0]) {
+		return 0;
+	}
+	uint64_t lines = (uint64_t)(f[1] - f[0]) * vtotal + l[1] - l[0];
+	return (uint32_t)(lines * 1000000000ull / (t[1] - t[0]) * 1000 / vtotal);
+}
