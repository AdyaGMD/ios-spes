+/* Start independently of UFS, only for an explicit spes RAM-root test. */
+void spes_touch_probe(void);
+
+void
+spes_touch_probe(void)
+{
+	DTEntry platform;
+	int enabled = 0;
+	char root[32] = { 0 };
+	(void)PE_parse_boot_argn("spestouchprobe", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("rd", root, sizeof(root));
+	if (enabled == 1 && strcmp(root, "md0") == 0 &&
+	    SecureDTLookupEntry(NULL, "/spes-platform", &platform) == kSuccess) {
+		sweet_touch_init();
+	}
+}
