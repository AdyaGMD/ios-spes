+/*
+ * 0x49 (iOSPlus10 0232): the caller's pages [pointer, pointer + size) as a buffer. They are wired
+ * while the handle lives, so the GPU keeps the pages that were there even if the program unmaps
+ * the range; read-only ones may be the program's read-only memory and are read-only to the GPU.
+ * The kernel maps them too, to push the program's writes out of the cache before every
+ * submission that names the buffer (as a surface it has mapped); after the GPU writes, the
+ * program drops its own lines (Turnip's vkInvalidateMappedMemoryRanges, or CPU_PREP). Never kept
+ * for another buffer; only the task that opened the connection.
+ */
 IOReturn
+RedwoodGPUUserClient::hostBuffer(struct redwood_userptr * request)
+{
+	bool readOnly = (request->flags & kUserptrReadOnly) != 0;
+	IOMemoryDescriptor * memory;
+	IOMemoryMap * map;
+	struct gpu_buffer * b;
+
+	if ((request->flags & ~kUserptrReadOnly) != 0 || request->pointer == 0 || request->size == 0 ||
+	    (request->pointer & PAGE_MASK) || (request->size & PAGE_MASK) || request->size > GPU_BUFFER_MAX ||
+	    request->pointer + request->size < request->pointer) {
+		return kIOReturnBadArgument;
+	}
+	if (current_task() != fTask) {
+		return kIOReturnNotPermitted;
+	}
+	memory = IOMemoryDescriptor::withAddressRange((mach_vm_address_t)request->pointer, (mach_vm_size_t)request->size,
+	    readOnly ? kIODirectionOut : kIODirectionInOut, fTask);
+	if (memory == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (memory->prepare() != kIOReturnSuccess) {
+		memory->release();
+		return kIOReturnVMError;                /* not mapped, or not writable without kUserptrReadOnly */
+	}
+	map = memory->createMappingInTask(kernel_task, 0, kIOMapAnywhere);
+	if (map == NULL) {
+		memory->complete();
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	redwood_gpu_to_memory((void *)map->getVirtualAddress(), request->size);
+	redwood_gpu_to_memory(NULL, 0);
+	IOLockLock(gGPULock);
+	b = newBuffer(memory, 0, request->size, readOnly ? MSM_BO_GPU_READONLY : 0, &request->handle);
+	if (b != NULL) {
+		b->memory = memory;
+		b->kernel = (uint8_t *)map->getVirtualAddress();
+		b->map = map;
+		b->host = true;
+		b->seen = true;
+	}
+	IOLockUnlock(gGPULock);
+	if (b == NULL) {
+		map->release();
+		memory->complete();
+		memory->release();
+		return kIOReturnNoMemory;
+	}
+	return kIOReturnSuccess;
+}
