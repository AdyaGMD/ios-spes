+/*
+ * Stage 3 (spescodec=3): a stream into the codec, the amplifiers still off (silent). As HackiOS's
+ * redwood_sound.c sound=2 over APR, on spes's own path: the audio DMA stream SID 0x1C1 passes
+ * addresses through (Topaz), a 64 KB buffer from the pool below 4 GiB holds 16 periods of a 1 kHz
+ * tone at -20 dBFS, ASM maps it (address msw 1: the SID's low bits), the codec DMA port
+ * RX_CDC_DMA_RX_1 (0xb032, AIF2 -> RX2 -> INT2 -> AUX as on Topaz) is configured and started, an
+ * ADM device path routes session 1 to it, and an ASM stream plays the tone for 3 s; then Topaz's
+ * SoundWire data ports and the WCD937x AUX PA. The DSP's "write done" events say it takes the
+ * samples. Everything is closed afterwards.
+ */
+#define S3_PORT             0xb032u
+#define S3_SESSION          1u
+#define S3_STREAM_PORT      ((S3_SESSION << 8) | 1)
+#define S3_PERIODS          16u
+#define S3_PERIOD_BYTES     4096u
+#define S3_PERIOD_FRAMES    (S3_PERIOD_BYTES / 4)
+
+static const int16_t s3_tone[48] = {
+	0, 428, 848, 1254, 1638, 1995, 2317, 2600, 2838, 3028, 3165, 3249,
+	3277, 3249, 3165, 3028, 2838, 2600, 2317, 1995, 1638, 1254, 848, 428,
+	0, -428, -848, -1254, -1638, -1995, -2317, -2600, -2838, -3028, -3165, -3249,
+	-3277, -3249, -3165, -3028, -2838, -2600, -2317, -1995, -1638, -1254, -848, -428,
+};
+
+/* Send and pump the link until the reply for `want' (an opcode or a basic result for it). */
+static bool
+s3_call(const char *what, uint8_t service, uint16_t port, uint32_t opcode, const void *payload, uint32_t len,
+    uint32_t want)
+{
+	uint32_t seq = s3_rsp_seq;
+	apr_send_to(service, port, apr_token++, opcode, payload, len);
+	for (unsigned i = 0; i < 1000; i++) {
+		glink_poll();
+		if (s3_rsp_seq != seq && s3_rsp_opcode == want) {
+			bool ok = s3_rsp_status == 0;
+			LOG("t=%u.%03u codec: %s: %s %#x (words %08x %08x)", T, what, ok ? "ok" : "FAILED", s3_rsp_status,
+			    s3_rsp_word0, s3_rsp_word1);
+			return ok;
+		}
+		IOSleep(1);
+	}
+	LOG("t=%u.%03u codec: %s: no reply", T, what);
+	return false;
+}
+
+static void
+cdc_stage3(void)
+{
+	uint64_t pa = 0;
+	uint8_t *buf = (uint8_t *)spes_pool_alloc(S3_PERIODS * S3_PERIOD_BYTES, &pa);
+	if (buf == NULL || pa == 0 || pa + S3_PERIODS * S3_PERIOD_BYTES > (1ull << 32)) {
+		LOG("t=%u.%03u codec: stage 3: no buffer below 4 GiB (%#llx)", T, pa);
+		return;
+	}
+	if (!spes_smmu_identity(0x1C1, 0, "audio")) {
+		LOG("t=%u.%03u codec: stage 3: audio SID 0x1C1 not passed through", T);
+		return;
+	}
+	unsigned at = 0;
+	for (unsigned p = 0; p < S3_PERIODS; p++) {
+		int16_t *s = (int16_t *)(buf + p * S3_PERIOD_BYTES);
+		for (unsigned f = 0; f < S3_PERIOD_FRAMES; f++) {
+			s[2 * f] = s[2 * f + 1] = s3_tone[at++ % 48];
+		}
+	}
+	for (uintptr_t l = (uintptr_t)buf; l < (uintptr_t)buf + S3_PERIODS * S3_PERIOD_BYTES; l += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (l));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	struct { uint16_t pool, regions; uint32_t property, low, high, size; } __attribute__((packed)) map =
+	    { 3, 1, 0, (uint32_t)pa, 1, S3_PERIODS * S3_PERIOD_BYTES };
+	if (!s3_call("buffer mapped (ASM)", APR_SVC_ASM, 0, 0x00010d92u, &map, sizeof(map), ASM_CMDRSP_SHARED_MEM_MAP_REGIONS)) {
+		return;
+	}
+	uint32_t handle = s3_rsp_word0;
+
+	struct {
+		uint16_t port, size; uint32_t lsw, msw, handle;
+		uint32_t module, param; uint16_t psize, reserved;
+		uint32_t version, rate; uint16_t bits, format, channels, mask;
+	} __attribute__((packed)) cfg = { S3_PORT, 8 + 4 + 16, 0, 0, 0, 0x0001020cu, 0x000102b8u, 16, 0, 1, 48000, 16, 0, 2, 3 };
+	uint16_t start[2] = { S3_PORT, 0 };
+	bool port_on = s3_call("port 0xb032 configured (codec DMA, 2 x 16 bit, 48 kHz)", APR_SVC_AFE, 0, 0x000100efu, &cfg,
+	    sizeof(cfg), 0x000100efu) &&
+	    s3_call("port 0xb032 started", APR_SVC_AFE, 0, 0x000100e5u, start, sizeof(start), 0x000100e5u);
+
+	struct {
+		uint16_t flags, mode, endpoint1, endpoint2; uint32_t topology;
+		uint16_t channels, bits; uint32_t rate; uint8_t map[8];
+	} __attribute__((packed)) open = { 0, 1, S3_PORT, 0xffff, 0x00010312u, 2, 16, 48000, { 1, 2 } };
+	bool copp_open = port_on && s3_call("device path (ADM)", APR_SVC_ADM, S3_PORT, 0x00010326u, &open, sizeof(open),
+	    ADM_CMDRSP_DEVICE_OPEN_V5) && s3_rsp_word0 == 0;
+	uint16_t copp = (uint16_t)(s3_rsp_word1 & 0xffff);
+
+	struct { uint32_t flags; uint16_t sink, bits; uint32_t topology, format; } __attribute__((packed)) wr =
+	    { 0, 0, 16, 0x00010c68u, 0x00010da5u };
+	struct { uint32_t matrix, sessions; uint16_t session, copps; uint16_t copp[2]; } __attribute__((packed)) route =
+	    { 0, 1, (uint16_t)S3_SESSION, 1, { copp, 0 } };
+	struct { uint32_t size; uint16_t channels, bits; uint32_t rate; uint16_t is_signed, reserved; uint8_t map[8]; }
+	__attribute__((packed)) fmt = { 20, 2, 16, 48000, 1, 0, { 1, 2 } };
+	uint32_t run[3] = { 0, 0, 0 };
+	bool stream_open = copp_open &&
+	    s3_call("stream opened (ASM, 16-bit PCM)", APR_SVC_ASM, S3_STREAM_PORT, 0x00010db3u, &wr, sizeof(wr), 0x00010db3u);
+	bool running = stream_open &&
+	    s3_call("session routed to the device path", APR_SVC_ADM, 0, 0x00010325u, &route, sizeof(route), 0x00010325u) &&
+	    s3_call("stream format", APR_SVC_ASM, S3_STREAM_PORT, 0x00010d98u, &fmt, sizeof(fmt), 0x00010d98u) &&
+	    s3_call("session run", APR_SVC_ASM, S3_STREAM_PORT, 0x00010daau, run, sizeof(run), 0x00010daau);
+
+	if (running) {
+		/* Topaz ports_and_pa(): SoundWire data ports and the WCD937x AUX PA, after the start */
+		static const uint32_t slv[][2] = { { 0x203, 7 }, { 0x230, 1 }, { 0x232, 0x1F }, { 0x233, 0 }, { 0x234, 0 },
+			                           { 0x236, 0x36 }, { 0x430, 1 }, { 0x432, 7 }, { 0x433, 0 }, { 0x434, 1 } };
+		cdc_w(CDC_RX_SWR + 0x1264, 0x0100001F); cdc_w(CDC_RX_SWR + 0x127C, 0); cdc_w(CDC_RX_SWR + 0x122C, 7);
+		cdc_w(CDC_RX_SWR + 0x1274, 0x63);
+		cdc_w(CDC_RX_SWR + 0x1464, 0x01000107); cdc_w(CDC_RX_SWR + 0x147C, 0); cdc_w(CDC_RX_SWR + 0x1474, 0);
+		for (uint32_t i = 0; i < sizeof(slv) / sizeof(slv[0]); i++) {
+			cdc_swr_wr(CDC_RX_SWR, 1, slv[i][0], slv[i][1]);
+		}
+		cdc_w(CDC_RX_SWR + 0x105C, 0x5000F);
+		cdc_w(CDC_RX_SWR + 0x300, (0x0Fu << 24) | (15u << 20) | (15u << 16) | 0x70);
+		IOSleep(5);
+		cdc_swr_wr(CDC_VA_SWR, 1, 0x3467, 0x05);
+		cdc_swr_wr(CDC_VA_SWR, 1, 0x3128, 0x80);
+		cdc_swr_wr(CDC_VA_SWR, 1, 0x346B, 0x4C);
+		cdc_swr_wr(CDC_VA_SWR, 1, 0x346C, 0x7F);
+		cdc_swr_wr(CDC_VA_SWR, 1, 0x346D, 0x0F);
+		LOG("t=%u.%03u codec: ports + AUX PA on: rx frame %08x, irq %08x", T, cdc_r(CDC_RX_SWR + 0x105C),
+		    cdc_r(CDC_RX_SWR + 0x200));
+
+		/* 3 s of the tone: every period written again as the DSP gives it back */
+		s3_done = s3_underflows = s3_errors = s3_returned = 0;
+		for (uint32_t p = 0; p < S3_PERIODS; p++) {
+			uint32_t w[8] = { (uint32_t)(pa + p * S3_PERIOD_BYTES), 1, handle, S3_PERIOD_BYTES, p, 0, 0, 0 };
+			apr_send_to(APR_SVC_ASM, S3_STREAM_PORT, S3_WRITE_TOKEN | p, 0x00010dabu, w, sizeof(w));
+		}
+		unsigned began = ms();
+		while (ms() - began < 3000) {
+			glink_poll();
+			uint32_t back = s3_returned;
+			if (back != 0) {
+				s3_returned &= ~back;
+				for (uint32_t p = 0; p < S3_PERIODS; p++) {
+					if (back & (1u << p)) {
+						uint32_t w[8] = { (uint32_t)(pa + p * S3_PERIOD_BYTES), 1, handle, S3_PERIOD_BYTES, p, 0, 0, 0 };
+						apr_send_to(APR_SVC_ASM, S3_STREAM_PORT, S3_WRITE_TOKEN | p, 0x00010dabu, w, sizeof(w));
+					}
+				}
+			}
+			IOSleep(1);
+		}
+		LOG("t=%u.%03u codec: 3 s of tone: %u periods done (%u expected at 48 kHz), %u errors, %u underflows", T,
+		    s3_done, 3000u * 48 / S3_PERIOD_FRAMES, s3_errors, s3_underflows);
+	}
+	if (stream_open) {
+		s3_call("stream closed", APR_SVC_ASM, S3_STREAM_PORT, 0x00010bcdu, NULL, 0, 0x00010bcdu);
+	}
+	if (copp_open) {
+		s3_call("device path closed", APR_SVC_ADM, copp, 0x00010327u, NULL, 0, 0x00010327u);
+	}
+	if (port_on) {
+		uint16_t stop[2] = { S3_PORT, 0 };
+		s3_call("port stopped", APR_SVC_AFE, 0, 0x000100e6u, stop, sizeof(stop), 0x000100e6u);
+	}
+	s3_call("buffer unmapped", APR_SVC_ASM, 0, 0x00010d94u, &handle, sizeof(handle), 0x00010d94u);
 }
 
 static void
@@ -1588,6 +1805,9 @@
 	    cdc_r(CDC_VA_SWR + 0x1090), cdc_r(CDC_RX_SWR + 0x538), cdc_r(CDC_VA_SWR + 0x538));
 	if (wanted >= 2 && cdc_r(CDC_VA_SWR + 0x1090) != 0) {
 		cdc_stage2();
+		if (wanted >= 3) {
+			cdc_stage3();
+		}
 	}
 	cdc_step = 3;
 }
