+/*
+ * The RPM link stays open after the GPU probe's votes; other drivers (the audio codec's L14)
+ * send their requests over it. A second GLINK handshake on a link already used since boot
+ * crashed the RPM on topaz, so there is never another one: spes_rpm_kvp() waits for this one.
+ */
+static struct {
+	vm_offset_t ram, apcs;
+	uint32_t tx_off, tx_size, rx_off, rx_size, msg_id;
+	volatile bool up;
+	volatile uint32_t busy;
+} srpm;
 
+int spes_rpm_kvp(uint32_t set, uint32_t type, uint32_t id, uint32_t key, uint32_t value);
+
+/* One key/value request; 0 when the RPM acked it, -1 on no link or no ack. */
+int
+spes_rpm_kvp(uint32_t set, uint32_t type, uint32_t id, uint32_t key, uint32_t value)
+{
+	for (unsigned waited = 0; !srpm.up && waited < 30000; waited += 100) {
+		touch_wait(100);
+	}
+	if (!srpm.up) {
+		printf("SPES RPM: no link for request %#x/%u (the GPU probe opens it)\n", type, id);
+		return -1;
+	}
+	while (!OSCompareAndSwap(0, 1, &srpm.busy)) {
+		touch_wait(1);
+	}
+	struct {
+		struct glink_msg gmsg;
+		uint32_t chunk_size, left_size;
+		uint32_t service_type, request_len, msg_id, set, resource_type, resource_id, data_len;
+		uint32_t kvp_key, kvp_size, kvp_val;
+	} __attribute__((packed)) req;
+	memset(&req, 0, sizeof(req));
+	req.gmsg.cmd = 9;                       /* GLINK_CMD_TX_DATA */
+	req.gmsg.param1 = 1;                    /* lcid of rpm_requests */
+	req.chunk_size = 40;
+	req.service_type = 0x00716572u;         /* "req" */
+	req.request_len = 32u;
+	req.msg_id = ++srpm.msg_id;
+	req.set = set;
+	req.resource_type = type;
+	req.resource_id = id;
+	req.data_len = 12u;
+	req.kvp_key = key;
+	req.kvp_size = 4u;
+	req.kvp_val = value;
+	spes_rpm_pipe_write(srpm.ram, srpm.tx_off, srpm.tx_size, &req, sizeof(req), srpm.apcs);
+	struct glink_msg rmsg;
+	uint8_t ack[64];
+	uint32_t len = 0;
+	int ret = -1;
+	for (int i = 0; i < 100 && ret != 0; i++) {
+		if (spes_rpm_wait_msg(srpm.ram, srpm.rx_off, srpm.rx_size, &rmsg, ack, sizeof(ack), &len, 50) &&
+		    rmsg.cmd == 9) {
+			ret = 0;
+		}
+	}
+	OSCompareAndSwap(1, 0, &srpm.busy);
+	printf("SPES RPM: request set %u %#x/%u %#x=%u: %s\n", set, type, id, key, value, ret == 0 ? "acked" : "NO ACK");
+	return ret;
+}
