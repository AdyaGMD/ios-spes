+	/* SCM PIL_AUTH_RESET (cmd 0x05, arginfo = 1) */
+	uint64_t pil_auth_st = spes_scm(0x42000000u | (0x02u << 8) | 0x05u, 1, 13, 0, 0, &pil_res);
+	printf("SPES GPU: 25e. ZAP PIL_AUTH_RESET: st=%#llx res=%#llx\n", pil_auth_st, pil_res);
