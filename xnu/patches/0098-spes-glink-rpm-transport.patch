+struct glink_msg {
+	uint16_t cmd;
+	uint16_t param1;
+	uint32_t param2;
+} __attribute__((packed));
+
+static void
+spes_rpm_pipe_write(vm_offset_t ram, uint32_t offset, uint32_t size,
+    const void *data, uint32_t len, vm_offset_t apcs)
+{
+	uint32_t head = touch_rd(ram, offset + 4u);
+	uint32_t aligned_len = (len + 7u) & ~7u;
+	const uint8_t *src = (const uint8_t *)data;
+
+	for (uint32_t i = 0; i < aligned_len; i += 4) {
+		uint32_t w = 0;
+		for (uint32_t b = 0; b < 4 && (i + b) < len; ++b) {
+			w |= (uint32_t)src[i + b] << (8u * b);
+		}
+		touch_wr(ram, offset + 8u + head, w);
+		head += 4;
+		if (head >= size) head = 0;
+	}
+	__asm__ volatile("dmb sy" ::: "memory");
+	touch_wr(ram, offset + 4u, head);
+	__asm__ volatile("dmb sy" ::: "memory");
+	touch_wr(apcs, 0x8u, 1u);
+}
+
+static uint32_t
+spes_rpm_pipe_rx_avail(vm_offset_t ram, uint32_t offset, uint32_t size)
+{
+	uint32_t tail = touch_rd(ram, offset);
+	uint32_t head = touch_rd(ram, offset + 4u);
+	if (head < tail) {
+		return size - tail + head;
+	}
+	return head - tail;
+}
+
+static void
+spes_rpm_rx_peak(vm_offset_t ram, uint32_t offset, uint32_t size,
+    uint32_t rel_offset, void *dst, uint32_t len)
+{
+	uint32_t tail = touch_rd(ram, offset);
+	uint32_t pos = tail + rel_offset;
+	if (pos >= size) pos -= size;
+
+	uint8_t *out = (uint8_t *)dst;
+	for (uint32_t i = 0; i < len; i += 4) {
+		uint32_t w = touch_rd(ram, offset + 8u + pos);
+		for (uint32_t b = 0; b < 4 && (i + b) < len; ++b) {
+			out[i + b] = (w >> (8u * b)) & 0xffu;
+		}
+		pos += 4;
+		if (pos >= size) pos = 0;
+	}
+}
+
+static void
+spes_rpm_rx_advance(vm_offset_t ram, uint32_t offset, uint32_t size, uint32_t count)
+{
+	uint32_t tail = touch_rd(ram, offset);
+	tail += count;
+	while (tail >= size) tail -= size;
+	__asm__ volatile("dmb sy" ::: "memory");
+	touch_wr(ram, offset, tail);
+	__asm__ volatile("dmb sy" ::: "memory");
+}
+
+static bool
+spes_rpm_rx_next(vm_offset_t ram, uint32_t rx_off, uint32_t rx_size,
+    struct glink_msg *hdr, void *payload, uint32_t max_payload, uint32_t *out_payload_len)
+{
+	uint32_t avail = spes_rpm_pipe_rx_avail(ram, rx_off, rx_size);
+	if (avail < 8) return false;
+
+	spes_rpm_rx_peak(ram, rx_off, rx_size, 0, hdr, 8);
+	uint16_t cmd = hdr->cmd;
+
+	if (cmd == 9 /* GLINK_CMD_TX_DATA */) {
+		if (avail < 16) return false;
+		uint32_t data_hdr[2];
+		spes_rpm_rx_peak(ram, rx_off, rx_size, 8, data_hdr, 8);
+		uint32_t chunk_size = data_hdr[0];
+		if (chunk_size == 0 || chunk_size > rx_size) {
+			printf("SPES RPM: invalid chunk_size=%#x avail=%u\n", chunk_size, avail);
+			spes_rpm_rx_advance(ram, rx_off, rx_size, 8);
+			return false;
+		}
+		uint32_t chunk_aligned = (chunk_size + 7u) & ~7u;
+		if (avail < 16 + chunk_aligned) return false;
+
+		if (payload && max_payload > 0) {
+			uint32_t copy_len = chunk_size < max_payload ? chunk_size : max_payload;
+			spes_rpm_rx_peak(ram, rx_off, rx_size, 16, payload, copy_len);
+			if (out_payload_len) *out_payload_len = chunk_size;
+		}
+		spes_rpm_rx_advance(ram, rx_off, rx_size, 16 + chunk_aligned);
+		return true;
+	} else if (cmd == 2 /* GLINK_CMD_OPEN */) {
+		uint32_t name_len = hdr->param2;
+		uint32_t name_aligned = (name_len + 7u) & ~7u;
+		if (avail < 8 + name_aligned) return false;
+		spes_rpm_rx_advance(ram, rx_off, rx_size, 8 + name_aligned);
+		if (out_payload_len) *out_payload_len = 0;
+		return true;
+	} else {
+		/* All other commands (0, 1, 3, 4, 15) are exactly 8 bytes */
+		spes_rpm_rx_advance(ram, rx_off, rx_size, 8);
+		if (out_payload_len) *out_payload_len = 0;
+		return true;
+	}
+}
+
+static bool
+spes_rpm_wait_msg(vm_offset_t ram, uint32_t rx_off, uint32_t rx_size,
+    struct glink_msg *hdr, void *payload, uint32_t max_payload, uint32_t *out_payload_len,
+    unsigned timeout_ms)
+{
+	for (unsigned t = 0; t < timeout_ms; t += 10) {
+		if (spes_rpm_rx_next(ram, rx_off, rx_size, hdr, payload, max_payload, out_payload_len)) {
+			return true;
+		}
+		touch_wait(10);
+	}
+	return false;
+}
+
+static uint64_t
+spes_smc(uint64_t a[8])
+{
+	register uint64_t x0 __asm__("x0") = a[0], x1 __asm__("x1") = a[1], x2 __asm__("x2") = a[2],
+	    x3 __asm__("x3") = a[3], x4 __asm__("x4") = a[4], x5 __asm__("x5") = a[5], x6 __asm__("x6") = a[6],
+	    x7 __asm__("x7") = a[7];
+	__asm__ volatile ("smc #0"
+            : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+            :
+            : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	a[0] = x0; a[1] = x1; a[2] = x2; a[3] = x3; a[4] = x4; a[5] = x5; a[6] = x6; a[7] = x7;
+	return x0;
+}
+
+static uint64_t
+spes_scm(uint32_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *res1)
+{
+	uint64_t args[8] = { fn, arginfo, a, b, c, 0, 0, 0 };
+	spes_smc(args);
+	for (unsigned n = 0; args[0] == 1 && n < 100000; n++) {
+		uint64_t again[8] = { 1, arginfo, a, b, c, 0, args[6], 0 };
+		memcpy(args, again, sizeof(args));
+		spes_smc(args);
+	}
+	if (res1 != NULL) {
+		*res1 = args[1];
+	}
+	return args[0];
+}
+
+static void
+to_memory(vm_offset_t start, vm_size_t size)
+{
+	for (vm_offset_t line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+spes_glink_rpm_probe(void)
+{
+	int enabled = 0;
+	(void)PE_parse_boot_argn("spesrpmprobe", &enabled, sizeof(enabled));
+	if (!st.spes || enabled != 1) return;
+
+	printf("SPES RPM: 1. start probe\n");
+	vm_offset_t ram = ml_io_map(0x045f0000u, 0x7000u);
+	vm_offset_t apcs = ml_io_map(0x0f111000u, 0x1000u);
+	printf("SPES RPM: 2. map ram=%p apcs=%p\n", (void *)ram, (void *)apcs);
+	if (!ram || !apcs) return;
+
+	uint32_t magic = touch_rd(ram, 0x6f00u);
+	printf("SPES RPM: 3. TOC magic=%#x\n", magic);
+	if (magic != 0x67727430u) return;
+
+	uint32_t tx_off = 0x200u, tx_size = 0x6f8u;
+	uint32_t rx_off = 0x900u, rx_size = 0x6f8u;
+	printf("SPES RPM: 4. TX head=%#x tail=%#x\n",
+	    touch_rd(ram, tx_off + 4u), touch_rd(ram, tx_off));
+	printf("SPES RPM: 5. RX head=%#x tail=%#x\n",
+	    touch_rd(ram, rx_off + 4u), touch_rd(ram, rx_off));
+
+	/* Step 1: Send GLINK_CMD_VERSION */
+	printf("SPES RPM: 6. sending VERSION (v=1, feat=2)\n");
+	struct glink_msg vmsg = { 0 /* VERSION */, 1 /* v1 */, 2 /* INTENTLESS */ };
+	spes_rpm_pipe_write(ram, tx_off, tx_size, &vmsg, 8, apcs);
+
+	/* Step 2: Negotiate GLINK v1 */
+	bool rpm_v_acked = false;
+	bool my_v_acked = false;
+	struct glink_msg rmsg;
+	for (int iter = 0; iter < 50; ++iter) {
+		if (spes_rpm_wait_msg(ram, rx_off, rx_size, &rmsg, NULL, 0, NULL, 50)) {
+			printf("SPES RPM: rx cmd=%u p1=%u p2=%#x\n", rmsg.cmd, rmsg.param1, rmsg.param2);
+			if (rmsg.cmd == 0 /* VERSION */) {
+				struct glink_msg ack = { 1 /* VERSION_ACK */, rmsg.param1, 0 };
+				spes_rpm_pipe_write(ram, tx_off, tx_size, &ack, 8, apcs);
+				rpm_v_acked = true;
+			} else if (rmsg.cmd == 1 /* VERSION_ACK */) {
+				my_v_acked = true;
+			}
+			if (rpm_v_acked && my_v_acked) break;
+		}
+	}
+	if (!my_v_acked) {
+		printf("SPES RPM: version negotiation timed out; stopping\n");
+		return;
+	}
+	printf("SPES RPM: 7. GLINK v1 transport established!\n");
+	touch_wait(100);
+
+	/* Step 3: Open channel rpm_requests */
+	uint8_t open_buf[24] = {0};
+	struct glink_msg *open_msg = (struct glink_msg *)open_buf;
+	open_msg->cmd = 2; /* OPEN */
+	open_msg->param1 = 1; /* lcid = 1 */
+	open_msg->param2 = 13; /* strlen("rpm_requests") + 1 */
+	memcpy(open_buf + 8, "rpm_requests", 13);
+	printf("SPES RPM: 8. opening 'rpm_requests' (lcid=1)\n");
+	spes_rpm_pipe_write(ram, tx_off, tx_size, open_buf, 24, apcs);
+
+	uint16_t req_rcid = 0;
+	bool my_open_acked = false;
+
+	for (int iter = 0; iter < 50; ++iter) {
+		if (spes_rpm_wait_msg(ram, rx_off, rx_size, &rmsg, NULL, 0, NULL, 50)) {
+			printf("SPES RPM: rx cmd=%u p1=%u p2=%#x\n", rmsg.cmd, rmsg.param1, rmsg.param2);
+			if (rmsg.cmd == 4 /* OPEN_ACK */) {
+				if (rmsg.param1 == 1) {
+					my_open_acked = true;
+					printf("SPES RPM: local lcid=1 OPEN_ACK verified!\n");
+				}
+			} else if (rmsg.cmd == 2 /* OPEN from remote */) {
+				printf("SPES RPM: remote OPEN rcid=%u len=%u, sending OPEN_ACK\n",
+				    rmsg.param1, rmsg.param2);
+				if (rmsg.param2 == 13) {
+					req_rcid = rmsg.param1;
+				}
+				struct glink_msg oack = { 4 /* OPEN_ACK */, rmsg.param1, 0 };
+				spes_rpm_pipe_write(ram, tx_off, tx_size, &oack, 8, apcs);
+			} else if (rmsg.cmd == 15 /* SIGNALS */) {
+				printf("SPES RPM: SIGNALS rcid=%u val=%#x\n", rmsg.param1, rmsg.param2);
+			}
+			if (my_open_acked && req_rcid != 0) {
+				break;
+			}
+		}
+	}
+
+	if (!my_open_acked || req_rcid == 0) {
+		printf("SPES RPM: channel open failed (acked=%d, rcid=%u); stopping\n",
+		    my_open_acked, req_rcid);
+		return;
+	}
+	printf("SPES RPM: 9. 'rpm_requests' OPEN bidirectional (rcid=%u)!\n", req_rcid);
+	touch_wait(100);
+
+	/* Step 4: Send vote for rwcx=64 */
+	struct {
+		struct glink_msg gmsg;
+		uint32_t chunk_size;
+		uint32_t left_size;
+		uint32_t service_type;
+		uint32_t request_len;
+		uint32_t msg_id;
+		uint32_t set;
+		uint32_t resource_type;
+		uint32_t resource_id;
+		uint32_t data_len;
+		uint32_t kvp_key;
+		uint32_t kvp_size;
+		uint32_t kvp_val;
+	} __attribute__((packed)) req;
+
+	memset(&req, 0, sizeof(req));
+	req.gmsg.cmd = 9; /* GLINK_CMD_TX_DATA */
+	req.gmsg.param1 = 1; /* lcid = 1 (AP channel ID) */
+	req.gmsg.param2 = 0; /* iid */
+	req.chunk_size = 40;
+	req.left_size = 0;
+
+	req.service_type = 0x00716572u; /* "req\0" */
+	req.request_len = 32u;
+	req.msg_id = 1u;
+	req.set = 0u; /* active */
+	req.resource_type = 0x78637772u; /* "rwcx" */
+	req.resource_id = 0u;
+	req.data_len = 12u;
+	req.kvp_key = 0x6c766c76u; /* "vlvl" */
+	req.kvp_size = 4u;
+	req.kvp_val = 64u; /* corner 64 = LOW_SVS */
+
+	printf("SPES RPM: 10a. writing 56b rwcx vote (lcid=1 msg_id=1)\n");
+	touch_wait(100);
+	spes_rpm_pipe_write(ram, tx_off, tx_size, &req, sizeof(req), apcs);
+	printf("SPES RPM: 10b. doorbell kicked! Waiting for RPM ACK...\n");
+
+	uint8_t ack_payload[64] = {0};
+	uint32_t ack_len = 0;
+	bool rwcx_acked = false;
+	for (int iter = 0; iter < 100; ++iter) {
+		if (spes_rpm_wait_msg(ram, rx_off, rx_size, &rmsg, ack_payload, sizeof(ack_payload), &ack_len, 50)) {
+			printf("SPES RPM: rx cmd=%u p1=%u len=%u\n", rmsg.cmd, rmsg.param1, ack_len);
+			if (rmsg.cmd == 9 /* TX_DATA */) {
+				uint32_t *ack = (uint32_t *)ack_payload;
+				printf("SPES RPM: ACK payload [%#x, %#x, %#x]\n", ack[0], ack[1], ack[2]);
+				rwcx_acked = true;
+				break;
+			}
+		}
+	}
+	if (!rwcx_acked) {
+		printf("SPES RPM: rwcx vote timed out; stopping\n");
+		return;
+	}
+	printf("SPES RPM: 11. rwcx vote confirmed!\n");
+	touch_wait(100);
+
+	/* Step 5: Send vote for rwmx=64 */
+	req.gmsg.param1 = 1; /* lcid = 1 */
+	req.msg_id = 2u;
+	req.resource_type = 0x786d7772u; /* "rwmx" */
+	printf("SPES RPM: 12a. writing 56b rwmx vote (lcid=1 msg_id=2)\n");
+	touch_wait(100);
+	spes_rpm_pipe_write(ram, tx_off, tx_size, &req, sizeof(req), apcs);
+	printf("SPES RPM: 12b. doorbell kicked! Waiting for RPM ACK...\n");
+
+	bool rwmx_acked = false;
+	for (int iter = 0; iter < 100; ++iter) {
+		if (spes_rpm_wait_msg(ram, rx_off, rx_size, &rmsg, ack_payload, sizeof(ack_payload), &ack_len, 50)) {
+			printf("SPES RPM: rx cmd=%u p1=%u len=%u\n", rmsg.cmd, rmsg.param1, ack_len);
+			if (rmsg.cmd == 9 /* TX_DATA */) {
+				uint32_t *ack = (uint32_t *)ack_payload;
+				printf("SPES RPM: ACK payload [%#x, %#x, %#x]\n", ack[0], ack[1], ack[2]);
+				rwmx_acked = true;
+				break;
+			}
+		}
+	}
+	if (!rwmx_acked) {
+		printf("SPES RPM: rwmx vote timed out; stopping\n");
+		return;
+	}
+	printf("SPES RPM: 13. rwmx vote confirmed!\n");
+	touch_wait(200);
+
+	/* Step 6: Uncollapse CX GDSC */
+	vm_offset_t cc = ml_io_map(0x05990000u, 0x9000u);
+	if (!cc) {
+		printf("SPES GPU: GPUCC map failed\n");
+		return;
+	}
+	printf("SPES GPU: 14. CX GDSC uncollapse (curr=%#x)\n", touch_rd(cc, 0x106c));
+	touch_wr(cc, 0x106c, touch_rd(cc, 0x106c) & ~1u);
+	bool cx_on = false;
+	for (int i = 0; i < 200; ++i) {
+		uint32_t val = touch_rd(cc, 0x106c);
+		if (val & (1u << 31)) {
+			printf("SPES GPU: 15. CX GDSC powered ON! val=%#x (poll %d)\n", val, i);
+			cx_on = true;
+			break;
+		}
+		touch_wait(5);
+	}
+	if (!cx_on) {
+		printf("SPES GPU: CX GDSC power-on timed out; reg=%#x\n", touch_rd(cc, 0x106c));
+		return;
+	}
+	touch_wait(50);
+
+	/* Step 7: Uncollapse GX GDSC */
+	printf("SPES GPU: 16. GX GDSC uncollapse (curr=%#x)\n", touch_rd(cc, 0x100c));
+	touch_wr(cc, 0x100c, touch_rd(cc, 0x100c) & ~1u);
+	bool gx_on = false;
+	for (int i = 0; i < 200; ++i) {
+		uint32_t val = touch_rd(cc, 0x100c);
+		if (val & (1u << 31)) {
+			printf("SPES GPU: 17. GX GDSC powered ON! val=%#x (poll %d)\n", val, i);
+			gx_on = true;
+			break;
+		}
+		touch_wait(5);
+	}
+	if (!gx_on) {
+		printf("SPES GPU: GX GDSC power-on timed out; reg=%#x\n", touch_rd(cc, 0x100c));
+		return;
+	}
+	touch_wait(50);
+
+	/* Step 8: Ungate branch clocks */
+	touch_wr(cc, 0x1078, touch_rd(cc, 0x1078) | 1u); /* AHB */
+	touch_wr(cc, 0x109c, touch_rd(cc, 0x109c) | 1u); /* CXO */
+	touch_wait(10);
+	printf("SPES GPU: 18. clocks ahb=%#x cxo=%#x\n",
+	    touch_rd(cc, 0x1078), touch_rd(cc, 0x109c));
+
+	/* Step 9: Configure and start GFX RCG clock (CXO 19.2 MHz safe baseline) */
+	printf("SPES GPU: 19. GFX RCG configure (curr cmd=%#x cfg=%#x)\n",
+	    touch_rd(cc, 0x101c), touch_rd(cc, 0x1020));
+	touch_wr(cc, 0x1020, 0u); /* SRC_SEL = 0 (CXO 19.2MHz), DIV = 0 (div 1) */
+	touch_wr(cc, 0x101c, 3u); /* ROOT_EN=1, UPDATE=1 */
+	bool rcg_ok = false;
+	for (int i = 0; i < 100; ++i) {
+		if (!(touch_rd(cc, 0x101c) & 1u)) {
+			rcg_ok = true;
+			break;
+		}
+		touch_wait(1);
+	}
+	printf("SPES GPU: 19b. GFX RCG updated (ok=%d cmd=%#x cfg=%#x)\n",
+	    rcg_ok, touch_rd(cc, 0x101c), touch_rd(cc, 0x1020));
+
+	if (!rcg_ok) { printf("SPES GPU: RCG update timeout; stopping\n"); return; }
+
+	/* Step 10: Ungate graphics core branch clocks */
+	touch_wr(cc, 0x108c, 1u); /* CX SNOC */
+	touch_wr(cc, 0x10a4, 1u); /* CX GFX */
+	touch_wr(cc, 0x1054, 1u); /* GX GFX */
+	touch_wait(10);
+	printf("SPES GPU: 20. branches snoc=%#x cx_gfx=%#x gx_gfx=%#x\n",
+	    touch_rd(cc, 0x108c), touch_rd(cc, 0x10a4), touch_rd(cc, 0x1054));
+
+	/* Step 11: Map Adreno 610 MMIO (16 KiB aperture) and unhalt GBIF */
+	vm_offset_t gpu = ml_io_map(0x05900000u, 0x90000u);
+	if (!gpu) {
+		printf("SPES GPU: GPU core MMIO map failed\n");
+		return;
+	}
+	touch_wr(gpu, 0x58u, 0u); /* A6XX_RBBM_GBIF_HALT = 0 */
+	touch_wr(gpu, 0xf114u, 0u); /* A6XX_GBIF_HALT = 0 */
+	touch_wait(5);
+
+	/* Step 12: Read and decode RBBM status and control registers */
+	uint32_t rbbm_status = touch_rd(gpu, 0x840u);
+	uint32_t rbbm_status3 = touch_rd(gpu, 0x84cu);
+	uint32_t gbif_halt = touch_rd(gpu, 0x58u);
+	uint32_t int0_status = touch_rd(gpu, 0x804u);
+	uint32_t vbif_reset = touch_rd(gpu, 0x854u);
+
+	printf("SPES GPU: 21. RBBM_STATUS=%#x (idle=%d) STATUS3=%#x\n",
+	    rbbm_status, (rbbm_status & ~1u) == 0, rbbm_status3);
+	printf("SPES GPU: 21b. GBIF_HALT=%#x INT0=%#x VBIF_RESET=%#x\n",
+	    gbif_halt, int0_status, vbif_reset);
+	uint32_t cp1_hw_fault = touch_rd(gpu, 0x2084u);
+	uint32_t cp1_int_stat = touch_rd(gpu, 0x208cu);
+	uint32_t cp1_rbbm_int = touch_rd(gpu, 0x804u);
+	printf("SPES GPU: 21c. Checkpoint 1 (GPU MMIO): fault=%#x int=%#x rbbm_int0=%#x\n",
+	    cp1_hw_fault, cp1_int_stat, cp1_rbbm_int);
+	printf("SPES GPU: 22. GPU STAGE-2 COMPLETE!\n");
+
+	/* ================================================================
+	 * STAGE 3: SMMUv2, TrustZone PAS 13, SQE Microcode, Ringbuffer NOP
+	 * ================================================================ */
+	printf("SPES GPU: starting Stage 3 bringup...\n");
+
+	vm_offset_t smmu = 0;
+	uint32_t cb0_off = 0;
+#define LOG_CP(tag) do { \
+		__asm__ volatile ("dsb sy" ::: "memory"); \
+		uint32_t _gfsr = smmu ? touch_rd(smmu, 0x48u) : 0u; \
+		uint32_t _fsr  = (smmu && cb0_off) ? touch_rd(smmu, cb0_off + 0x58u) : 0u; \
+		printf("SPES GPU: %s: int=%#x fault=%#x int0=%#x rbbm=%#x sqe=%#x gfsr=%#x fsr=%#x\n", \
+		    tag, \
+		    touch_rd(gpu, 0x208cu), touch_rd(gpu, 0x2084u), \
+		    touch_rd(gpu, 0x804u), touch_rd(gpu, 0x840u), \
+		    touch_rd(gpu, 0x2020u), _gfsr, _fsr); \
+	} while (0)
+
+	/* Khaje GPU memory path: do not access SMMU before its clocks are on. */
+	touch_wr(st.gcc, 0x3600cu, touch_rd(st.gcc, 0x3600cu) | 1u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* Checkpoint 22c: After MEMNOC clock enable */
+	printf("SPES GPU: 22c. CP-22c (MEMNOC): int=%#x fault=%#x int0=%#x rbbm=%#x sqe=%#x memnoc=%#x\n",
+	    touch_rd(gpu, 0x208cu), touch_rd(gpu, 0x2084u),
+	    touch_rd(gpu, 0x804u), touch_rd(gpu, 0x840u),
+	    touch_rd(gpu, 0x2020u), touch_rd(st.gcc, 0x3600cu));
+
+	touch_wr(st.gcc, 0x36018u, touch_rd(st.gcc, 0x36018u) | 1u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* Checkpoint 22d: After SNOC clock enable */
+	printf("SPES GPU: 22d. CP-22d (SNOC): int=%#x fault=%#x int0=%#x rbbm=%#x sqe=%#x snoc=%#x\n",
+	    touch_rd(gpu, 0x208cu), touch_rd(gpu, 0x2084u),
+	    touch_rd(gpu, 0x804u), touch_rd(gpu, 0x840u),
+	    touch_rd(gpu, 0x2020u), touch_rd(st.gcc, 0x36018u));
+
+	touch_wr(cc, 0x5000u, touch_rd(cc, 0x5000u) | 1u);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* Checkpoint 22e: After SMMU clock enable */
+	printf("SPES GPU: 22e. CP-22e (SMMU_CLK): int=%#x fault=%#x int0=%#x rbbm=%#x sqe=%#x smmu_clk=%#x\n",
+	    touch_rd(gpu, 0x208cu), touch_rd(gpu, 0x2084u),
+	    touch_rd(gpu, 0x804u), touch_rd(gpu, 0x840u),
+	    touch_rd(gpu, 0x2020u), touch_rd(cc, 0x5000u));
+
+	unsigned clock_poll;
+	for (clock_poll = 0; clock_poll < 100; ++clock_poll) {
+		if (!((touch_rd(st.gcc, 0x3600cu) | touch_rd(st.gcc, 0x36018u) |
+		    touch_rd(cc, 0x5000u)) & (1u << 31))) break;
+		touch_wait(1);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SPES GPU: memory clocks memnoc=%#x snoc=%#x smmu=%#x (poll=%u)\n",
+	    touch_rd(st.gcc, 0x3600cu), touch_rd(st.gcc, 0x36018u), touch_rd(cc, 0x5000u), clock_poll);
+
+	/* Checkpoint 22f: After clock polling completes */
+	printf("SPES GPU: 22f. CP-22f (CLKPOLL): int=%#x fault=%#x int0=%#x rbbm=%#x sqe=%#x (poll=%u)\n",
+	    touch_rd(gpu, 0x208cu), touch_rd(gpu, 0x2084u),
+	    touch_rd(gpu, 0x804u), touch_rd(gpu, 0x840u),
+	    touch_rd(gpu, 0x2020u), clock_poll);
+
+	if (clock_poll == 100) { printf("SPES GPU: memory clock timeout; stopping\n"); return; }
+
+	/* Controlled early-halt experiment. Default is the no-write control.
+	 * Both diagnostic modes stop before SMMU changes or command submission.
+	 * Mode 0 opts into setup without the early SQE halt. */
+	int halt_test = 1;
+	(void)PE_parse_boot_argn("spesgpuhalt", &halt_test, sizeof(halt_test));
+	if (halt_test != 0) {
+		if (halt_test != 2) halt_test = 1;
+		struct halt_sample {
+			uint32_t irq, fault, rbbm, cntl;
+		} samples[2][11];
+		printf("SPES GPU: halt-test mode=%d (1=control 2=halt) base=%#x:%#x gbif=%#x\n",
+		    halt_test, touch_rd(gpu, 0x20c4u), touch_rd(gpu, 0x20c0u), touch_rd(gpu, 0xf114u));
+		for (unsigned phase = 0; phase < 2; ++phase) {
+			if (phase == 1 && halt_test == 2) touch_wr(gpu, 0x2020u, 3u);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			for (unsigned i = 0; i < 11; ++i) {
+				if (i != 0) touch_wait(1);
+				samples[phase][i].irq = touch_rd(gpu, 0x208cu);
+				samples[phase][i].fault = touch_rd(gpu, 0x2084u);
+				samples[phase][i].rbbm = touch_rd(gpu, 0x840u);
+				samples[phase][i].cntl = touch_rd(gpu, 0x2020u);
+			}
+		}
+		for (unsigned phase = 0; phase < 2; ++phase) {
+			for (unsigned i = 0; i < 11; ++i) {
+				printf("SPES GPU: halt-test p=%u sample=%u int=%#x fault=%#x rbbm=%#x sqe=%#x\n",
+				    phase, i, samples[phase][i].irq, samples[phase][i].fault,
+				    samples[phase][i].rbbm, samples[phase][i].cntl);
+			}
+		}
+		printf("SPES GPU: halt-test STOP; no SMMU setup or packets\n");
+		return;
+	}
+	/* Paired hardware test: early SQE=3 causes a delayed CP error.
+	 * Keep the clean boot state until firmware and memory are ready. */
+	if (touch_rd(gpu, 0x208cu) || touch_rd(gpu, 0x2084u) ||
+	    touch_rd(gpu, 0x2020u) != 0u) {
+		printf("SPES GPU: fault before memory setup; stopping\n");
+		return;
+	}
