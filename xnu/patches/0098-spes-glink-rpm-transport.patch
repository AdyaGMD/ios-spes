+	/* Map ZAP firmware staging DMA area (0x56615000) */
+	vm_offset_t dma_va = ml_io_map(0x56615000u, 0x2000u);
+	if (!dma_va) {
+		printf("SPES GPU: ml_io_map(0x56615000) failed\n");
+		return;
+	}
+
+	uint64_t zap_pa = 0x56615000u;
+	uint64_t zap_size = 0x2000u;
+	volatile uint32_t *zap_dst = (volatile uint32_t *)dma_va;
+	for (unsigned zi = 0; zi < sizeof(a610_zap_b02) / sizeof(uint32_t); zi++) {
+		zap_dst[zi] = a610_zap_b02[zi];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SPES GPU: 25b. ZAP b02 (%lu bytes) at pa=%#llx va=%#lx\n",
+	    sizeof(a610_zap_b02), zap_pa, (unsigned long)dma_va);
