+	touch_wr(gpu, 0x00dcu, 0xffffffffu); /* RBBM_INT_CLEAR_CMD */
+	touch_wr(gpu, 0x00e0u, 0x00000000u); /* RBBM_INT_0_MASK */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* Checkpoint 2D: after RBBM interrupt-clear operations */
+	LOG_CP("25d. CP-2D (INTCLR)");
+
+	unsigned sqe_err = 0;
+	for (unsigned si = 0; si < sizeof(a630_sqe_fw) / sizeof(uint32_t); si++) {
+		if (sqe_dst[si] != a630_sqe_fw[si]) {
+			sqe_err++;
+		}
+	}
+	printf("SPES GPU: 26. SQE mem (%lu B): err=%u d0-3=%#x %#x %#x %#x\n",
+	    sizeof(a630_sqe_fw), sqe_err, sqe_dst[0], sqe_dst[1], sqe_dst[2], sqe_dst[3]);
+	printf("SPES GPU: 26b. SQE mem d4-7=%#x %#x %#x %#x (match=%d)\n",
+	    sqe_dst[4], sqe_dst[5], sqe_dst[6], sqe_dst[7], (sqe_err == 0));
+
+	/* Point SQE instruction base to 0x01100000 (mapped to sqe_pa in Context 0!) */
+	touch_wr(gpu, 0x20c0u, 0x01100000u);           /* CP_SQE_INSTR_BASE_LO */
+	touch_wr(gpu, 0x20c4u, 0x00000000u);           /* CP_SQE_INSTR_BASE_HI */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t base_lo = touch_rd(gpu, 0x20c0u);
+	uint32_t base_hi = touch_rd(gpu, 0x20c4u);
+	printf("SPES GPU: 26c. CP_SQE_INSTR_BASE=%#x:%#x (match=%d)\n",
+	    base_hi, base_lo, (base_lo == 0x01100000u && base_hi == 0u));
+	/* Checkpoint 2E: after SQE instruction-base programming */
+	LOG_CP("26c2. CP-2E (SQEBASE)");
+
+	/* Program Ringbuffer registers: ring at 0x01000000, RPTR scratch at 0x011f0000 */
+	touch_wr(gpu, 0x2000u, 0x01000000u);           /* CP_RB_BASE_LO */
+	touch_wr(gpu, 0x2004u, 0x00000000u);           /* CP_RB_BASE_HI */
+	touch_wr(gpu, 0x2008u, 0x0800020au);           /* CP_RB_CNTL (8K ring, 32B block, bit 27 = NO_UPDATE) */
+	touch_wr(gpu, 0x2010u, 0x011f0000u);           /* CP_RB_RPTR_ADDR_LO */
+	touch_wr(gpu, 0x2014u, 0x00000000u);           /* CP_RB_RPTR_ADDR_HI */
+	touch_wr(gpu, 0x2018u, 0u);                    /* CP_RB_RPTR */
+	touch_wr(gpu, 0x201cu, 0u);                    /* CP_RB_WPTR */
+	touch_wr(gpu, 0x2214u, 0u);                    /* CP_SCRATCH(2) */
+	/* 0x2090 is CP_PROTECT_STATUS, NOT CP_INT_ACK. Do not write it. */
+	/* A610 has no expanded APRIV capability; do not program CP_APRIV_CNTL. */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	/* Checkpoint 2G: ring configured, expanded APRIV deliberately untouched */
+	LOG_CP("26c4. CP-2G (RING)");
+
+	/* Checkpoint 3: Before CP_SQE_CNTL = 1 */
+	LOG_CP("26d. Checkpoint 3 (Pre-Unhalt)");
+
+	/* Setup-only is the default until routing/readback is observed on device. */
+	if (sqe_err || base_lo != 0x01100000u || base_hi != 0u ||
+	    touch_rd(gpu, 0x208cu) || touch_rd(gpu, 0x2084u) ||
+	    touch_rd(gpu, 0x2020u) != 0u || touch_rd(smmu, 0x48u) ||
+	    (touch_rd(smmu, context + 0x58u) & 0xc00001feu)) {
+		printf("SPES GPU: setup verification failed; STOP before SQE release\n");
+		return;
+	}
+	int run_sqe = 0;
+	(void)PE_parse_boot_argn("spesgpurun", &run_sqe, sizeof(run_sqe));
+	if (run_sqe != 1) {
+		printf("SPES GPU: setup verified; STOP before SQE release (no packets)\n");
+		return;
+	}
+
+	/* Step 19: Un-halt CP SQE engine BEFORE submitting init */
+	touch_wr(gpu, 0x2020u, 1u); /* CP_SQE_CNTL = 1 */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	touch_wait(10);
+
+	/* Checkpoint 3B: After CP_SQE_CNTL = 1 */
+	LOG_CP("26e. Post-unhalt 1");
+	touch_wr(gpu, 0x2420u, 0u); uint32_t sqe_dbg0 = touch_rd(gpu, 0x2424u);
+	touch_wr(gpu, 0x2420u, 1u); uint32_t sqe_dbg1 = touch_rd(gpu, 0x2424u);
+	touch_wr(gpu, 0x2420u, 2u); uint32_t sqe_dbg2 = touch_rd(gpu, 0x2424u);
+	touch_wr(gpu, 0x2420u, 3u); uint32_t sqe_dbg3 = touch_rd(gpu, 0x2424u);
+	uint32_t pre_rptr   = touch_rd(gpu, 0x2018u);
+	uint32_t pre_wptr   = touch_rd(gpu, 0x201cu);
+	rbbm_status         = touch_rd(gpu, 0x840u);
+	printf("SPES GPU: 26f. SQE dbg0-3: %#x %#x %#x %#x (rptr=%u wptr=%u)\n",
+	    sqe_dbg0, sqe_dbg1, sqe_dbg2, sqe_dbg3, pre_rptr, pre_wptr);
+
+	/* Halt safely only if a true hardware fault occurs */
+	uint32_t cp3b_fault = touch_rd(gpu, 0x2084u);
+	if (cp3b_fault != 0 || touch_rd(gpu, 0x208cu) != 0) {
+		touch_wr(gpu, 0x2020u, 3u); /* CP_SQE_CNTL = 3 */
+		printf("SPES GPU: Hardware fault on unhalt; halted safely before packets\n");
+		return;
+	}
+#undef LOG_CP
+	/* Step 20: Submit CP_ME_INIT (Linux upstream A6xx sequence) */
+	uint32_t w = 0;
+	rb[w++] = 0x70c80008u; /* CP_ME_INIT (opcode 0x48, count 8) */
+	rb[w++] = 0x0000002fu; /* ordinal 1: init mask */
+	rb[w++] = 0x00000003u; /* ordinal 2: max contexts = 3 */
+	rb[w++] = 0x20000000u; /* ordinal 3: error detection */
+	rb[w++] = 0x00000000u; /* ordinal 4: header dump = 0 */
+	rb[w++] = 0x00000000u; /* ordinal 5: reset state = 0 */
+	rb[w++] = 0x00000000u; /* ordinal 6: ucode wa = 0 */
+	rb[w++] = 0x00000000u; /* ordinal 7: pad = 0 */
+	rb[w++] = 0x00000000u; /* ordinal 8: pad = 0 */
+
+	/* CP_NOP padding to 16 dwords */
+	while (w < 16) {
+		rb[w++] = 0x70108000u; /* zero payload requires count parity bit 15 */
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	/* Kick WPTR for Test 1: CP_ME_INIT */
+	touch_wr(gpu, 0x201cu, w);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SPES GPU: 27. Test 1: CP_ME_INIT submitted (wptr=%u)\n", w);
+
+	/* Bounded poll for CP_ME_INIT retirement with inline fault checking */
+	int poll_init;
+	bool init_adv = false;
+	uint32_t rptr_init = 0;
+	for (poll_init = 0; poll_init < 1000; poll_init++) {
+		rptr_init = touch_rd(gpu, 0x2018u);
+		uint32_t pf  = touch_rd(gpu, 0x2084u);
+		uint32_t pi0 = touch_rd(gpu, 0x804u);
+		uint32_t pgf = touch_rd(smmu, 0x48u);
+		uint32_t pfs = touch_rd(smmu, context + 0x58u);
+
+		/* Break early on newly asserted hardware fault, error IRQ, or translation fault */
+		if (pf != 0 || ((pi0 & ~cp1_rbbm_int) & 0x31c002c2u) != 0 ||
+		    pgf != 0 || (pfs & 0xc00000feu) != 0) {
+			break;
+		}
+		if (rptr_init > 0) {
+			init_adv = true;
+			if (rptr_init >= w) break;
+		}
+		touch_wait(1);
+	}
+
+	/* Checkpoint 4A: CP_ME_INIT results */
+	uint32_t cp4a_fault = touch_rd(gpu, 0x2084u);
+	uint32_t cp4a_int   = touch_rd(gpu, 0x208cu);
+	uint32_t cp4a_int0  = touch_rd(gpu, 0x804u);
+	rbbm_status         = touch_rd(gpu, 0x840u);
+	uint32_t smmu_gfsr_4a = touch_rd(smmu, 0x48u);
+	uint32_t smmu_fsr_4a  = touch_rd(smmu, context + 0x58u);
+	bool smmu_fault_4a    = (smmu_gfsr_4a != 0) || ((smmu_fsr_4a & 0xc00000feu) != 0);
+	bool int0_new_err_4a  = ((cp4a_int0 & ~cp1_rbbm_int) & 0x31c002c2u) != 0;
+
+	printf("SPES GPU: 27b. Checkpoint 4A (CP_ME_INIT): rptr=%u / wptr=%u (adv=%d ok=%d poll=%d rbbm=%#x)\n",
+	    rptr_init, w, init_adv, (rptr_init >= w), poll_init, rbbm_status);
+	printf("SPES GPU: 27c. Checkpoint 4A diag: fault=%#x int=%#x int0=%#x GFSR=%#x FSR=%#x (smmu_err=%d int0_err=%d)\n",
+	    cp4a_fault, cp4a_int, cp4a_int0, smmu_gfsr_4a, smmu_fsr_4a, smmu_fault_4a, int0_new_err_4a);
+
+	/* Verify Stage A success before attempting Stage B (CP_MEM_WRITE) */
+	if (!init_adv || rptr_init < w || cp4a_fault != 0 || int0_new_err_4a || smmu_fault_4a) {
+		touch_wr(gpu, 0x2020u, 3u); /* CP_SQE_CNTL = 3 (halt SQE) */
+		printf("SPES GPU: 27d. Test 1 (CP_ME_INIT) FAILED; halted safely, skipping MEM_WRITE\n");
+		return;
+	}
+	printf("SPES GPU: 27d. Test 1 (CP_ME_INIT) PASSED! SQE alive and taking commands.\n");
+
+	/* Test 2: Submit CP_MEM_WRITE to scratch buffer */
+	uint32_t w2 = w;
+	rb[w2++] = 0x703d8003u; /* CP_MEM_WRITE (opcode 0x3d, count 3) */
+	rb[w2++] = 0x10000000u; /* target address LO (mapped to scratch[0] in Context 0) */
+	rb[w2++] = 0x00000000u; /* target address HI */
+	rb[w2++] = 0xcafe0001u; /* test payload */
+
+	/* CP_NOP padding to 32 dwords */
+	while (w2 < 32) {
+		rb[w2++] = 0x70108000u;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	/* Kick WPTR for Test 2: CP_MEM_WRITE */
+	touch_wr(gpu, 0x201cu, w2);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SPES GPU: 28. Test 2: CP_MEM_WRITE submitted (wptr=%u)\n", w2);
+
+	/* Bounded poll for CP_MEM_WRITE retirement with inline fault checking */
+	int poll_mem;
+	bool mem_adv = false;
+	uint32_t rptr_mem = 0;
+	for (poll_mem = 0; poll_mem < 1000; poll_mem++) {
+		rptr_mem = touch_rd(gpu, 0x2018u);
+		uint32_t pf  = touch_rd(gpu, 0x2084u);
+		uint32_t pi0 = touch_rd(gpu, 0x804u);
+		uint32_t pgf = touch_rd(smmu, 0x48u);
+		uint32_t pfs = touch_rd(smmu, context + 0x58u);
+
+		if (pf != 0 || ((pi0 & ~cp1_rbbm_int) & 0x31c002c2u) != 0 ||
+		    pgf != 0 || (pfs & 0xc00000feu) != 0) {
+			break;
+		}
+		if (rptr_mem > w) {
+			mem_adv = true;
+			if (rptr_mem >= w2) break;
+		}
+		touch_wait(1);
+	}
+
+	/* Checkpoint 4B: CP_MEM_WRITE results */
+	uint32_t cp4b_fault = touch_rd(gpu, 0x2084u);
+	uint32_t cp4b_int   = touch_rd(gpu, 0x208cu);
+	uint32_t cp4b_int0  = touch_rd(gpu, 0x804u);
+	rbbm_status         = touch_rd(gpu, 0x840u);
+	uint32_t smmu_gfsr_4b = touch_rd(smmu, 0x48u);
+	uint32_t smmu_fsr_4b  = touch_rd(smmu, context + 0x58u);
+	uint32_t smmu_fsynr_4b= touch_rd(smmu, context + 0x68u);
+	uint32_t smmu_far_hi_4b= touch_rd(smmu, context + 0x64u);
+	uint32_t smmu_far_lo_4b= touch_rd(smmu, context + 0x60u);
+	bool smmu_fault_4b    = (smmu_gfsr_4b != 0) || ((smmu_fsr_4b & 0xc00000feu) != 0);
+	bool int0_new_err_4b  = ((cp4b_int0 & ~cp1_rbbm_int) & 0x31c002c2u) != 0;
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t scratch0   = scratch[0];
+	int scratch_match   = (scratch0 == 0xcafe0001u);
+
+	printf("SPES GPU: 28b. Checkpoint 4B (MEM_WRITE): rptr=%u / wptr=%u (adv=%d ok=%d poll=%d rbbm=%#x)\n",
+	    rptr_mem, w2, mem_adv, (rptr_mem >= w2), poll_mem, rbbm_status);
+	printf("SPES GPU: 28c. Checkpoint 4B diag: fault=%#x int=%#x int0=%#x scratch0=%#x (match=%d int0_err=%d)\n",
+	    cp4b_fault, cp4b_int, cp4b_int0, scratch0, scratch_match, int0_new_err_4b);
+	printf("SPES GPU: 28d. Checkpoint 4B SMMU: GFSR=%#x FSR=%#x (fault=%d) FSYNR=%#x FAR=%#x:%#x\n",
+	    smmu_gfsr_4b, smmu_fsr_4b, smmu_fault_4b, smmu_fsynr_4b, smmu_far_hi_4b, smmu_far_lo_4b);
