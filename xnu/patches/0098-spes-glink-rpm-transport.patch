+		    scratch0);
+	} else {
+		printf("SPES GPU: 29. STOPPED: rptr=%u wptr=%u match=%d fault=%#x int0_err=%d smmu_err=%d (halted safely)\n",
+		    rptr_mem, w2, scratch_match, cp4b_fault, int0_new_err_4b, smmu_fault_4b);
+	}
+	return;
+	/* Allocate contiguous buffer for ZAP MDT metadata (8 KiB) */
+	vm_offset_t mdt_va = 0;
+	if (kmem_alloc_contig(kernel_map, &mdt_va, 8192, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SPES GPU: kmem_alloc_contig for ZAP MDT failed\n");
+		return;
+	}
+	uint64_t mdt_pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)mdt_va));
+	volatile uint32_t *mdt_dst = (volatile uint32_t *)mdt_va;
+	for (unsigned mi = 0; mi < sizeof(a610_zap_mdt) / sizeof(uint32_t); mi++) {
+		mdt_dst[mi] = a610_zap_mdt[mi];
+	}
+	to_memory(mdt_va, sizeof(a610_zap_mdt));
+	printf("SPES GPU: 25a. ZAP MDT (%lu bytes) at pa=%#llx va=%#lx\n",
+	    sizeof(a610_zap_mdt), mdt_pa, (unsigned long)mdt_va);
