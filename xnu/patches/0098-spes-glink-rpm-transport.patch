+
+/* GLINK transport and RPM-SMD v0 communication on spes (SM6225).
+ * live FDT: qcom,glink-rpm over message RAM 0x045f0000, 0x7000 bytes.
+ * Doorbell: APCS HMSS at 0x0f111000, offset 0x8, bit 0.
+ * Opt-in via boot-arg spesrpmprobe=1.
+ */
+struct glink_msg {
+	uint16_t cmd;
+	uint16_t param1;
+	uint32_t param2;
+} __attribute__((packed));
+
+static void
+spes_rpm_pipe_write(vm_offset_t ram, uint32_t offset, uint32_t size,
+    const void *data, uint32_t len, vm_offset_t apcs)
+{
+	uint32_t head = touch_rd(ram, offset + 4u);
+	uint32_t aligned_len = (len + 7u) & ~7u;
+	const uint8_t *src = (const uint8_t *)data;
+
+	for (uint32_t i = 0; i < aligned_len; i += 4) {
+		uint32_t w = 0;
+		for (uint32_t b = 0; b < 4 && (i + b) < len; ++b) {
+			w |= (uint32_t)src[i + b] << (8u * b);
+		}
+		touch_wr(ram, offset + 8u + head, w);
+		head += 4;
+		if (head >= size) head = 0;
+	}
+	touch_wr(ram, offset + 4u, head);
+	touch_wr(apcs, 0x8u, 1u);
+}
+
+static uint32_t
+spes_rpm_pipe_rx_avail(vm_offset_t ram, uint32_t offset, uint32_t size)
+{
+	uint32_t tail = touch_rd(ram, offset);
+	uint32_t head = touch_rd(ram, offset + 4u);
+	if (head < tail) {
+		return size - tail + head;
+	}
+	return head - tail;
+}
+
+static void
+spes_rpm_pipe_rx_read(vm_offset_t ram, uint32_t offset, uint32_t size,
+    void *dst, uint32_t len)
+{
+	uint32_t tail = touch_rd(ram, offset);
+	uint32_t aligned_len = (len + 7u) & ~7u;
+	uint8_t *out = (uint8_t *)dst;
+
+	for (uint32_t i = 0; i < aligned_len; i += 4) {
+		uint32_t w = touch_rd(ram, offset + 8u + tail);
+		for (uint32_t b = 0; b < 4 && (i + b) < len; ++b) {
+			out[i + b] = (w >> (8u * b)) & 0xffu;
+		}
+		tail += 4;
+		if (tail >= size) tail = 0;
+	}
+	touch_wr(ram, offset, tail);
+}
+
+static bool
+spes_rpm_rx_msg(vm_offset_t ram, uint32_t rx_off, uint32_t rx_size,
+    struct glink_msg *msg, void *payload, uint32_t max_payload, unsigned timeout_ms)
+{
+	for (unsigned t = 0; t < timeout_ms; ++t) {
+		uint32_t avail = spes_rpm_pipe_rx_avail(ram, rx_off, rx_size);
+		if (avail >= 8) {
+			spes_rpm_pipe_rx_read(ram, rx_off, rx_size, msg, 8);
+			uint32_t extra = 0;
+			if (msg->cmd == 2 /* OPEN */) {
+				extra = (msg->param2 + 7u) & ~7u;
+			} else if (msg->cmd == 9 /* TX_DATA */) {
+				uint32_t data_hdr[2] = {0};
+				spes_rpm_pipe_rx_read(ram, rx_off, rx_size, data_hdr, 8);
+				extra = (data_hdr[0] + 7u) & ~7u;
+			}
+			if (extra > 0 && payload && extra <= max_payload) {
+				spes_rpm_pipe_rx_read(ram, rx_off, rx_size, payload, extra);
+			} else if (extra > 0) {
+				uint32_t dummy = 0;
+				for (uint32_t i = 0; i < extra; i += 4) {
+					spes_rpm_pipe_rx_read(ram, rx_off, rx_size, &dummy, 4);
+				}
+			}
+			return true;
+		}
+		delay(1000);
+	}
+	return false;
 }
 
 static void
+spes_glink_rpm_probe(void)
+{
+	int enabled = 0;
+	(void)PE_parse_boot_argn("spesrpmprobe", &enabled, sizeof(enabled));
+	if (!st.spes || enabled != 1) return;
+
+	printf("SPES RPM: stage=glink-init starting GLINK transport probe\n");
+	vm_offset_t ram = ml_io_map(0x045f0000u, 0x7000u);
+	vm_offset_t apcs = ml_io_map(0x0f111000u, 0x1000u);
+	if (!ram || !apcs) {
+		printf("SPES RPM: mapping failed ram=%p apcs=%p\n", (void *)ram, (void *)apcs);
+		return;
+	}
+
+	uint32_t magic = touch_rd(ram, 0x6f00u);
+	if (magic != 0x67727430u) {
+		printf("SPES RPM: bad TOC magic %#x\n", magic);
+		return;
+	}
+	uint32_t tx_off = 0x200u, tx_size = 0x6f8u;
+	uint32_t rx_off = 0x900u, rx_size = 0x6f8u;
+
+	printf("SPES RPM: rings TX off=%#x size=%#x RX off=%#x size=%#x\n",
+	    tx_off, tx_size, rx_off, rx_size);
+
+	/* Step 1: Send GLINK_CMD_VERSION */
+	struct glink_msg vmsg = { 0 /* VERSION */, 1 /* v1 */, 2 /* INTENTLESS */ };
+	printf("SPES RPM: sending GLINK_CMD_VERSION (v=1, feat=2)\n");
+	spes_rpm_pipe_write(ram, tx_off, tx_size, &vmsg, 8, apcs);
+
+	/* Step 2: Wait for VERSION_ACK */
+	struct glink_msg rmsg = {0, 0, 0};
+	bool v_acked = false;
+	for (int iter = 0; iter < 10; ++iter) {
+		if (spes_rpm_rx_msg(ram, rx_off, rx_size, &rmsg, NULL, 0, 100)) {
+			printf("SPES RPM: rx cmd=%u p1=%u p2=%#x\n", rmsg.cmd, rmsg.param1, rmsg.param2);
+			if (rmsg.cmd == 1 /* VERSION_ACK */) {
+				v_acked = true;
+				break;
+			} else if (rmsg.cmd == 0 /* VERSION */) {
+				struct glink_msg ack = { 1 /* VERSION_ACK */, rmsg.param1, rmsg.param2 };
+				spes_rpm_pipe_write(ram, tx_off, tx_size, &ack, 8, apcs);
+				v_acked = true;
+				break;
+			}
+		}
+	}
+	if (!v_acked) {
+		printf("SPES RPM: version negotiation timed out; stopping\n");
+		return;
+	}
+	printf("SPES RPM: GLINK v1 negotiation SUCCESS\n");
+
+	/* Step 3: Open channel rpm_requests */
+	uint8_t open_buf[24] = {0};
+	struct glink_msg *open_msg = (struct glink_msg *)open_buf;
+	open_msg->cmd = 2; /* OPEN */
+	open_msg->param1 = 1; /* lcid */
+	open_msg->param2 = 13; /* strlen("rpm_requests") + 1 */
+	memcpy(open_buf + 8, "rpm_requests", 13);
+	printf("SPES RPM: sending GLINK_CMD_OPEN 'rpm_requests' (lcid=1)\n");
+	spes_rpm_pipe_write(ram, tx_off, tx_size, open_buf, 24, apcs);
+
+	/* Step 4: Wait for OPEN_ACK */
+	bool open_acked = false;
+	for (int iter = 0; iter < 10; ++iter) {
+		if (spes_rpm_rx_msg(ram, rx_off, rx_size, &rmsg, NULL, 0, 100)) {
+			printf("SPES RPM: rx cmd=%u p1=%u p2=%#x\n", rmsg.cmd, rmsg.param1, rmsg.param2);
+			if (rmsg.cmd == 4 /* OPEN_ACK */) {
+				open_acked = true;
+				break;
+			}
+		}
+	}
+	if (!open_acked) {
+		printf("SPES RPM: channel open timed out; stopping\n");
+		return;
+	}
+	printf("SPES RPM: channel rpm_requests OPEN_ACK received!\n");
+
+	/* Step 5: Send voltage vote for rwcx (LOW_SVS = 64) */
+	struct {
+		struct glink_msg gmsg;
+		uint32_t chunk_size;
+		uint32_t left_size;
+		uint32_t service_type;
+		uint32_t request_len;
+		uint32_t msg_id;
+		uint32_t set;
+		uint32_t resource_type;
+		uint32_t resource_id;
+		uint32_t data_len;
+		uint32_t kvp_key;
+		uint32_t kvp_size;
+		uint32_t kvp_val;
+	} __attribute__((packed)) req;
+
+	memset(&req, 0, sizeof(req));
+	req.gmsg.cmd = 9; /* GLINK_CMD_TX_DATA */
+	req.gmsg.param1 = 1; /* lcid */
+	req.gmsg.param2 = 0; /* iid */
+	req.chunk_size = 40;
+	req.left_size = 0;
+
+	req.service_type = 0x00716572u; /* "req\0" */
+	req.request_len = 32u;
+	req.msg_id = 1u;
+	req.set = 0u; /* active */
+	req.resource_type = 0x78637772u; /* "rwcx" */
+	req.resource_id = 0u;
+	req.data_len = 12u;
+	req.kvp_key = 0x6c766c76u; /* "vlvl" */
+	req.kvp_size = 4u;
+	req.kvp_val = 64u; /* corner 64 = LOW_SVS */
+
+	printf("SPES RPM: sending vote rwcx=64 (msg_id=1)\n");
+	spes_rpm_pipe_write(ram, tx_off, tx_size, &req, sizeof(req), apcs);
+
+	uint8_t ack_payload[64] = {0};
+	bool rwcx_acked = false;
+	for (int iter = 0; iter < 10; ++iter) {
+		if (spes_rpm_rx_msg(ram, rx_off, rx_size, &rmsg, ack_payload, sizeof(ack_payload), 100)) {
+			printf("SPES RPM: rx cmd=%u p1=%u p2=%#x\n", rmsg.cmd, rmsg.param1, rmsg.param2);
+			if (rmsg.cmd == 9 /* TX_DATA */) {
+				uint32_t *ack = (uint32_t *)ack_payload;
+				printf("SPES RPM: ACK payload req=%#x req_len=%u id_ack=%u\n",
+				    ack[0], ack[1], ack[4]);
+				if (ack[4] == 1u) {
+					rwcx_acked = true;
+					break;
+				}
+			}
+		}
+	}
+	if (!rwcx_acked) {
+		printf("SPES RPM: rwcx vote ACK timed out\n");
+		return;
+	}
+	printf("SPES RPM: rwcx vote SUCCESS (ACK id=1 verified)\n");
+
+	/* Step 6: Send voltage vote for rwmx (LOW_SVS = 64) */
+	req.msg_id = 2u;
+	req.resource_type = 0x786d7772u; /* "rwmx" */
+	printf("SPES RPM: sending vote rwmx=64 (msg_id=2)\n");
+	spes_rpm_pipe_write(ram, tx_off, tx_size, &req, sizeof(req), apcs);
+
+	bool rwmx_acked = false;
+	for (int iter = 0; iter < 10; ++iter) {
+		if (spes_rpm_rx_msg(ram, rx_off, rx_size, &rmsg, ack_payload, sizeof(ack_payload), 100)) {
+			printf("SPES RPM: rx cmd=%u p1=%u p2=%#x\n", rmsg.cmd, rmsg.param1, rmsg.param2);
+			if (rmsg.cmd == 9 /* TX_DATA */) {
+				uint32_t *ack = (uint32_t *)ack_payload;
+				printf("SPES RPM: ACK payload req=%#x req_len=%u id_ack=%u\n",
+				    ack[0], ack[1], ack[4]);
+				if (ack[4] == 2u) {
+					rwmx_acked = true;
+					break;
+				}
+			}
+		}
+	}
+	if (!rwmx_acked) {
+		printf("SPES RPM: rwmx vote ACK timed out\n");
+		return;
+	}
+	printf("SPES RPM: rwmx vote SUCCESS (ACK id=2 verified)\n");
+
+	/* Step 7: Now that parent supplies are active, uncollapse CX GDSC */
+	vm_offset_t cc = ml_io_map(0x05990000u, 0x9000u);
+	if (!cc) {
+		printf("SPES RPM: GPUCC map failed\n");
+		return;
+	}
+	printf("SPES GPU: attempting CX GDSC uncollapse (current=%#x)\n", touch_rd(cc, 0x106c));
+	touch_wr(cc, 0x106c, touch_rd(cc, 0x106c) & ~1u); /* clear SW_COLLAPSE */
+	bool cx_on = false;
+	for (int i = 0; i < 100; ++i) {
+		uint32_t val = touch_rd(cc, 0x106c);
+		if (val & (1u << 31)) {
+			printf("SPES GPU: CX GDSC powered ON! val=%#x (poll %d)\n", val, i);
+			cx_on = true;
+			break;
+		}
+		delay(100);
+	}
+	if (!cx_on) {
+		printf("SPES GPU: CX GDSC power-on timed out; reg=%#x\n", touch_rd(cc, 0x106c));
+		return;
+	}
+
+	/* Step 8: Uncollapse GX GDSC */
+	printf("SPES GPU: attempting GX GDSC uncollapse (current=%#x)\n", touch_rd(cc, 0x100c));
+	touch_wr(cc, 0x100c, touch_rd(cc, 0x100c) & ~1u); /* clear SW_COLLAPSE */
+	bool gx_on = false;
+	for (int i = 0; i < 100; ++i) {
+		uint32_t val = touch_rd(cc, 0x100c);
+		if (val & (1u << 31)) {
+			printf("SPES GPU: GX GDSC powered ON! val=%#x (poll %d)\n", val, i);
+			gx_on = true;
+			break;
+		}
+		delay(100);
+	}
+	if (!gx_on) {
+		printf("SPES GPU: GX GDSC power-on timed out; reg=%#x\n", touch_rd(cc, 0x100c));
+		return;
+	}
+
+	/* Step 9: Ungate AHB and CXO branch clocks */
+	touch_wr(cc, 0x1078, touch_rd(cc, 0x1078) | 1u); /* AHB CBCR */
+	touch_wr(cc, 0x109c, touch_rd(cc, 0x109c) | 1u); /* CXO CBCR */
+	printf("SPES GPU: clock ungate ahb=%#x cxo=%#x\n",
+	    touch_rd(cc, 0x1078), touch_rd(cc, 0x109c));
+
+	/* Step 10: Both power domains ON! Read GPU chip ID */
+	vm_offset_t gpu = ml_io_map(0x05900000u, 0x1000u);
+	if (gpu) {
+		uint32_t chipid = touch_rd(gpu, 0x0u);
+		printf("SPES GPU: *** CHIP ID READBACK = %#x (expect 0x06010001) ***\n", chipid);
+	}
+}
