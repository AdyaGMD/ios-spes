+
+/* GLINK transport and RPM-SMD v0 communication on spes (SM6225).
+ * live FDT: qcom,glink-rpm over message RAM 0x045f0000, 0x7000 bytes.
+ * Doorbell: APCS HMSS at 0x0f111000, offset 0x8, bit 0.
+ * Opt-in via boot-arg spesrpmprobe=1.
+ */
+struct glink_msg {
+	uint16_t cmd;
+	uint16_t param1;
+	uint32_t param2;
+} __attribute__((packed));
+
+static void
+spes_rpm_pipe_write(vm_offset_t ram, uint32_t offset, uint32_t size,
+    const void *data, uint32_t len, vm_offset_t apcs)
+{
+	uint32_t head = touch_rd(ram, offset + 4u);
+	uint32_t aligned_len = (len + 7u) & ~7u;
+	const uint8_t *src = (const uint8_t *)data;
+
+	for (uint32_t i = 0; i < aligned_len; i += 4) {
+		uint32_t w = 0;
+		for (uint32_t b = 0; b < 4 && (i + b) < len; ++b) {
+			w |= (uint32_t)src[i + b] << (8u * b);
+		}
+		touch_wr(ram, offset + 8u + head, w);
+		head += 4;
+		if (head >= size) head = 0;
+	}
+	touch_wr(ram, offset + 4u, head);
+	touch_wr(apcs, 0x8u, 1u);
+}
+
+static uint32_t
+spes_rpm_pipe_rx_avail(vm_offset_t ram, uint32_t offset, uint32_t size)
+{
+	uint32_t tail = touch_rd(ram, offset);
+	uint32_t head = touch_rd(ram, offset + 4u);
+	if (head < tail) {
+		return size - tail + head;
+	}
+	return head - tail;
+}
+
+static void
+spes_rpm_pipe_rx_read(vm_offset_t ram, uint32_t offset, uint32_t size,
+    void *dst, uint32_t len)
+{
+	uint32_t tail = touch_rd(ram, offset);
+	uint32_t aligned_len = (len + 7u) & ~7u;
+	uint8_t *out = (uint8_t *)dst;
+
+	for (uint32_t i = 0; i < aligned_len; i += 4) {
+		uint32_t w = touch_rd(ram, offset + 8u + tail);
+		for (uint32_t b = 0; b < 4 && (i + b) < len; ++b) {
+			out[i + b] = (w >> (8u * b)) & 0xffu;
+		}
+		tail += 4;
+		if (tail >= size) tail = 0;
+	}
+	touch_wr(ram, offset, tail);
+}
+
+static bool
+spes_rpm_rx_msg(vm_offset_t ram, uint32_t rx_off, uint32_t rx_size,
+    struct glink_msg *msg, void *payload, uint32_t max_payload, unsigned timeout_ms)
+{
+	for (unsigned t = 0; t < timeout_ms; ++t) {
+		uint32_t avail = spes_rpm_pipe_rx_avail(ram, rx_off, rx_size);
+		if (avail >= 8) {
+			spes_rpm_pipe_rx_read(ram, rx_off, rx_size, msg, 8);
+			uint32_t extra = 0;
+			if (msg->cmd == 2 /* OPEN */) {
+				extra = (msg->param2 + 7u) & ~7u;
+			} else if (msg->cmd == 9 /* TX_DATA */) {
+				uint32_t data_hdr[2] = {0};
+				spes_rpm_pipe_rx_read(ram, rx_off, rx_size, data_hdr, 8);
+				extra = (data_hdr[0] + 7u) & ~7u;
+			}
+			if (extra > 0 && payload && extra <= max_payload) {
+				spes_rpm_pipe_rx_read(ram, rx_off, rx_size, payload, extra);
+			} else if (extra > 0) {
+				uint32_t dummy = 0;
+				for (uint32_t i = 0; i < extra; i += 4) {
+					spes_rpm_pipe_rx_read(ram, rx_off, rx_size, &dummy, 4);
+				}
+			}
+			return true;
+		}
+		delay(1000);
+	}
+	return false;
 }
 
 static void
+spes_glink_rpm_probe(void)
+{
+	int enabled = 0;
+	(void)PE_parse_boot_argn("spesrpmprobe", &enabled, sizeof(enabled));
+	if (!st.spes || enabled != 1) return;
+
+	printf("SPES RPM: 1. start probe\n");
+	vm_offset_t ram = ml_io_map(0x045f0000u, 0x7000u);
+	vm_offset_t apcs = ml_io_map(0x0f111000u, 0x1000u);
+	printf("SPES RPM: 2. map ram=%p apcs=%p\n", (void *)ram, (void *)apcs);
+	if (!ram || !apcs) return;
+
+	uint32_t magic = touch_rd(ram, 0x6f00u);
+	printf("SPES RPM: 3. TOC magic=%#x\n", magic);
+	if (magic != 0x67727430u) return;
+
+	uint32_t tx_off = 0x200u, tx_size = 0x6f8u;
+	uint32_t rx_off = 0x900u, rx_size = 0x6f8u;
+	printf("SPES RPM: 4. TX head=%#x tail=%#x\n",
+	    touch_rd(ram, tx_off + 4u), touch_rd(ram, tx_off));
+	printf("SPES RPM: 5. RX head=%#x tail=%#x\n",
+	    touch_rd(ram, rx_off + 4u), touch_rd(ram, rx_off));
+
+	/* TEST A: Test writing to Message RAM */
+	printf("SPES RPM: 6. testing RAM write at off %#x...\n", tx_off + 8u);
+	uint32_t old_val = touch_rd(ram, tx_off + 8u);
+	touch_wr(ram, tx_off + 8u, 0xa5a50001u);
+	uint32_t readback = touch_rd(ram, tx_off + 8u);
+	printf("SPES RPM: 7. RAM write OK: old=%#x readback=%#x\n", old_val, readback);
+	touch_wait(1000);
+
+	/* TEST B: Test APCS doorbell */
+	printf("SPES RPM: 8. testing APCS write at off 8...\n");
+	touch_wr(apcs, 0x8u, 1u);
+	printf("SPES RPM: 9. APCS write OK!\n");
+	touch_wait(1000);
+
+	/* TEST C: Send GLINK_CMD_VERSION */
+	printf("SPES RPM: 10. writing VERSION cmd\n");
+	struct glink_msg vmsg = { 0, 1, 2 };
+	spes_rpm_pipe_write(ram, tx_off, tx_size, &vmsg, 8, apcs);
+	printf("SPES RPM: 11. VERSION sent, polling RX...\n");
+
+	struct glink_msg rmsg = {0, 0, 0};
+	for (int i = 0; i < 20; ++i) {
+		uint32_t rx_head = touch_rd(ram, rx_off + 4u);
+		uint32_t rx_tail = touch_rd(ram, rx_off);
+		if (rx_head != rx_tail) {
+			printf("SPES RPM: RX activity! head=%#x tail=%#x\n", rx_head, rx_tail);
+			if (spes_rpm_rx_msg(ram, rx_off, rx_size, &rmsg, NULL, 0, 100)) {
+				printf("SPES RPM: rx cmd=%u p1=%u p2=%#x\n", rmsg.cmd, rmsg.param1, rmsg.param2);
+			}
+			break;
+		}
+		touch_wait(100);
+	}
+	printf("SPES RPM: 12. step complete\n");
+}
