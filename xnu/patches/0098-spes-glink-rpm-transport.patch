+	rb[w++] = 0x703d8006u;
+	rb[w++] = 0x011f0000u;
+	rb[w++] = 0x00000000u;
+	rb[w++] = 0x11223344u;
+	rb[w++] = 0x55667788u;
+	rb[w++] = 0x99aabbccu;
+	rb[w++] = 0xddeeff00u;
+
+	/* 3. CP_MEM_WRITE to Screen Framebuffer (0x5c069000: row 100, 32 green pixels) */
+	rb[w++] = 0x703d8022u;
+	rb[w++] = 0x5c069000u;
+	rb[w++] = 0x00000000u;
+	for (int px = 0; px < 32; px++) {
+		rb[w++] = 0x00ff00ffu; /* Bright green test pixels (ARGB) */
+	}
