+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	/* Advance WPTR to kick execution */
+	touch_wr(gpu, 0x201cu, w);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SPES GPU: 28. RING SUBMITTED: wptr=%u\n", w);
+
+	/* Step 21: Poll RPTR for retirement */
+	uint32_t curr_rptr = 0;
+	uint32_t cp_hw_fault = 0;
+	uint32_t cp_int_stat = 0;
+	bool consumed = false;
+	int poll_i = 0;
+	uint32_t last_rptr = 0;
+	for (poll_i = 0; poll_i < 1000; ++poll_i) {
+		curr_rptr = touch_rd(gpu, 0x2018u);
+		if (curr_rptr != last_rptr) {
+			printf("SPES GPU: 28b. Ring progress: rptr=%u / wptr=%u (poll=%d)\n",
+			    curr_rptr, w, poll_i);
+			last_rptr = curr_rptr;
+		}
+		if (curr_rptr >= w) {
+			consumed = true;
+			break;
+		}
+		touch_wait(2);
+	}
+	rbbm_status = touch_rd(gpu, 0x840u);
+	cp_hw_fault = touch_rd(gpu, 0x2084u);
+	cp_int_stat = touch_rd(gpu, 0x208cu);
+	uint32_t cp_scratch2 = touch_rd(gpu, 0x2214u);
+	printf("SPES GPU: 29. RING RETIREMENT: rptr=%u / wptr=%u (consumed=%d poll=%d rbbm=%#x fault=%#x int=%#x scratch2=%#x)\n",
