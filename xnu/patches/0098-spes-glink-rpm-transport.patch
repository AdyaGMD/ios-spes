+	/* 5. CP_EVENT_WRITE Fence to 0x011f0010 (fence_pa + 16!) */
+	rb[w++] = 0x70460004u;
+	rb[w++] = 0x08000031u; /* CACHE_FLUSH_TS with write timestamp */
+	rb[w++] = 0x011f0010u;
+	rb[w++] = 0x00000000u;
+	rb[w++] = 0xcafe0001u; /* Fence seqno marker */
+
+	/* 6. CP_NOP (Type 7, opcode 0x10, count 1) */
+	rb[w++] = 0x70100001u;
+	rb[w++] = 0xca11ab1eu;
