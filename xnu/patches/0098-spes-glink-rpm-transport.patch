+	/* SCM PIL_INIT_IMAGE (cmd 0x01, arginfo = 0x82) */
+	uint64_t pil_res = 0;
+	uint64_t pil_init_st = spes_scm(0x42000000u | (0x02u << 8) | 0x01u, 2 | (2 << 6), 13, mdt_pa, 0, &pil_res);
+	printf("SPES GPU: 25c. ZAP PIL_INIT_IMAGE: st=%#llx res=%#llx\n", pil_init_st, pil_res);
+
+	/* SCM PIL_MEM_SETUP (cmd 0x02, arginfo = 3) */
+	uint64_t pil_mem_st = spes_scm(0x42000000u | (0x02u << 8) | 0x02u, 3, 13, zap_pa, zap_size, &pil_res);
+	printf("SPES GPU: 25d. ZAP PIL_MEM_SETUP: st=%#llx res=%#llx (pa=%#llx)\n", pil_mem_st, pil_res, zap_pa);
