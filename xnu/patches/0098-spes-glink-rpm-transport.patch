+	/* Step 22: Verify GPU writes */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t val0 = scratch[0];
+	uint32_t val1 = scratch[1];
+	uint32_t val2 = scratch[2];
+	uint32_t val3 = scratch[3];
+	uint32_t fence_val = scratch[4];
