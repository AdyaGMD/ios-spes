+/* SoundWire command FIFO write: reg | id << 16 | dev << 20 | data << 24 (Topaz swr_wr) */
+static uint32_t cdc_swr_id;
 
 static void
+cdc_swr_wr(uint32_t master, uint32_t dev, uint32_t reg, uint32_t val)
+{
+	cdc_swr_id = (cdc_swr_id % 14) + 1;
+	cdc_w(master + 0x300, (val << 24) | (dev << 20) | (cdc_swr_id << 16) | reg);
+	IOSleep(1);
+}
