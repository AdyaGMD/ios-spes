+/*
+ * Stage 2 (spescodec=2): the RX macro as stock Android has it while playing, the RX0..2 paths
+ * muted, the WCD937x initialised over the VA bus (its TX slave, device 1) with its RX clocks and
+ * AUX DAC on, RX2's volume set (Topaz 0145 steps 8-9). Still silent: the DSP's stream, the
+ * SoundWire data ports, the AUX PA and the amplifiers come after.
+ */
+static void
+cdc_stage2(void)
+{
+	LOG("t=%u.%03u codec: stage 2, SWR irq before rx %08x va %08x", T, cdc_r(CDC_RX_SWR + 0x200),
+	    cdc_r(CDC_VA_SWR + 0x200));
+	for (uint32_t i = 0; i < sizeof(cdc_rx_stock) / sizeof(cdc_rx_stock[0]); i++) {
+		cdc_w(CDC_RX_MACRO + cdc_rx_stock[i][0], cdc_rx_stock[i][1]);
+	}
+	cdc_w(CDC_RX_MACRO + 0x400, 4); cdc_w(CDC_RX_MACRO + 0x480, 4); cdc_w(CDC_RX_MACRO + 0x500, 4);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x3103, 0xD6); IOSleep(2);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x312A, 0x00);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x3029, 0x85);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x3001, 0xC0); IOSleep(10); cdc_swr_wr(CDC_VA_SWR, 1, 0x3001, 0x80);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x30E2, 0xD9);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x30A5, 0xEB);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x3409, 0x08); cdc_swr_wr(CDC_VA_SWR, 1, 0x3408, 0x01); cdc_swr_wr(CDC_VA_SWR, 1, 0x3008, 0x01);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x340D, 0xBC); cdc_swr_wr(CDC_VA_SWR, 1, 0x340E, 0xBC); cdc_swr_wr(CDC_VA_SWR, 1, 0x340F, 0xBC);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x3408, 0x03);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x3408, 0x07); cdc_swr_wr(CDC_VA_SWR, 1, 0x3409, 0x0C); cdc_swr_wr(CDC_VA_SWR, 1, 0x344F, 0x01);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x3009, 0x0C); cdc_swr_wr(CDC_VA_SWR, 1, 0x300A, 0x40); cdc_swr_wr(CDC_VA_SWR, 1, 0x300B, 0x12);
+	cdc_swr_wr(CDC_VA_SWR, 1, 0x3008, 0x41); cdc_swr_wr(CDC_VA_SWR, 1, 0x3008, 0xC1);
+	cdc_w(CDC_RX_MACRO + 0x514, (uint32_t)(int8_t)-30 & 0xFF);     /* RX_RX2_RX_VOL_CTL, s8 dB */
+	IOSleep(5);
+	LOG("t=%u.%03u codec: stage 2 done, SWR irq after rx %08x va %08x, slaves rx %08x va %08x, rx2 vol %02x",
+	    T, cdc_r(CDC_RX_SWR + 0x200), cdc_r(CDC_VA_SWR + 0x200), cdc_r(CDC_RX_SWR + 0x1090),
+	    cdc_r(CDC_VA_SWR + 0x1090), cdc_r(CDC_RX_MACRO + 0x514) & 0xFF);
+}
