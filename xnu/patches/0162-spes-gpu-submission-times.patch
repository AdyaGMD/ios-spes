 #define SPES_GPU_MAX_IBS 128u
+/*
+ * How long the GPU itself spent on each submission: CP_REG_TO_MEM copies the always-on counter
+ * (CP_ALWAYS_ON_COUNTER 0x980, 19.2 MHz) before the indirect buffers and after CP_WAIT_FOR_IDLE
+ * into the fence page (GPU 0x011f0000, CPU dma+0xc000), 64 slots of start/end from 0x800, as
+ * msm's a6xx_submit does. spesgputime=0 leaves them out.
+ */
+#define SPES_GPU_TIME_SLOTS 64u
+static volatile uint64_t *spes_gpu_times(void){return (volatile uint64_t *)(sg.dma+0xc000+0x800);}
+static uint32_t spes_gpu_stamp(uint32_t *commands,uint32_t fence,unsigned end){
+ uint32_t gva=0x011f0800u+(fence%SPES_GPU_TIME_SLOTS)*16u+end*8u;
+ commands[0]=0x703e8003;commands[1]=0x980u|(2u<<18)|(1u<<30);commands[2]=gva;commands[3]=0;
+ return 4;
+}
