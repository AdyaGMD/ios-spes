+ if(done-sg.timed_through>SPES_GPU_TIME_SLOTS)from=done-SPES_GPU_TIME_SLOTS+1;
+ static const uint32_t limit[6]={100,250,500,1000,2000,4000};
+ for(uint32_t f=from;f!=done+1;++f){
