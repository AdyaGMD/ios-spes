 	void          setPanelLevel(uint32_t level);
 	void          setPanelOn(bool on);
+	void          rampPanelLevel(uint32_t from, uint32_t to);
 	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
 
