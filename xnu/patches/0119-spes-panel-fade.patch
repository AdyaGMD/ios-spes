+/*
+ * The backlight fade iOS shows on lock and wake: 16 DCS levels about 16 ms apart,
+ * on a squared curve so the dim end does not jump.
+ */
+void
+AppleCLCD::rampPanelLevel(uint32_t from, uint32_t to)
+{
+	const uint32_t steps = 16;
+	for (uint32_t i = 1; i <= steps; i++) {
+		uint32_t f = from > to ? steps - i : i;    /* 0..steps, toward the brighter end */
+		uint32_t lo = from < to ? from : to, hi = from < to ? to : from;
+		uint32_t level = lo + (uint32_t)(((uint64_t)(hi - lo) * f * f) / (steps * steps));
+		setPanelLevel(level < 1 ? 1 : level);
+		IOSleep(16);
+	}
+}
+
