 }
 
+static bool
+amp_se_setup(vm_offset_t se, uint32_t rx)
+{
+	if (amp_rd(se, SE_STATUS) & 0x1001u) {
+		printf("SPES AMP: SE1 busy (%#x); no transfers\n", amp_rd(se, SE_STATUS));
+		return false;
+	}
+	amp_wr(se, 0xe18, 0);
+	amp_wr(se, 0xe1c, 0);
+	amp_wr(se, 0x644, 0);
+	amp_wr(se, SE_IRQ_CLR, 0xffffffffu);
+	amp_wr(se, 0x648, 0xffffffffu);
+	amp_wr(se, SE_DMA, 0);
+	amp_wr(se, 0x28, amp_rd(se, 0x28) | 0x7fu);
+	amp_wr(se, 0xe30, amp_rd(se, 0xe30) | 0x0fu);
+	amp_wr(se, 0x24, 0x7f);
+	amp_wr(se, 0x20, 1);
+	amp_wr(se, SE_CLK_SEL, 0);
+	amp_wr(se, SE_MCLK, (2u << 4) | 1u);
+	amp_wr(se, SE_SCL, (5u << 20) | (11u << 10) | 22u);      /* 400 kHz */
+	amp_wr(se, 0x254, 0);
+	amp_wr(se, 0x260, SE_PACK0);
+	amp_wr(se, 0x264, SE_PACK1);
+	amp_wr(se, 0x284, SE_PACK0);
+	amp_wr(se, 0x288, SE_PACK1);
+	amp_wr(se, SE_TX_WM, 0);
+	amp_wr(se, 0x810, 0);
+	amp_wr(se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	amp_wr(se, SE_IRQ_EN, SE_DONE | SE_ERRORS | SE_TX_WM_IRQ | (3u << 26));
+	if ((amp_rd(se, SE_TX_COUNT) & 0xfffffffu) || (amp_rd(se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SPES AMP: inherited FIFO data; no transfers\n");
+		return false;
+	}
+	return true;
+}
+
+/* M_GENI_CMD_CANCEL, then ABORT; false if the engine does not come back idle. */
+static bool
+amp_abort(vm_offset_t se)
+{
+	amp_wr(se, SE_CTRL, 4);
+	for (unsigned i = 0; i < 1000 && !(amp_rd(se, SE_IRQ) & (1u << 4)); i++) {
+		delay(1);
+	}
+	if (!(amp_rd(se, SE_IRQ) & (1u << 4))) {
+		amp_wr(se, SE_CTRL, 2);
+		for (unsigned i = 0; i < 1000 && !(amp_rd(se, SE_IRQ) & (1u << 5)); i++) {
+			delay(1);
+		}
+	}
+	for (unsigned i = 0; i < 64 && (amp_rd(se, SE_RX_COUNT) & 0x1ffffffu); i++) {
+		(void)amp_rd(se, SE_RX);
+	}
+	amp_wr(se, SE_IRQ_CLR, 0xffffffffu);
+	return amp_wait_clear(se, SE_STATUS, 1u);
+}
+
+/*
+ * One message: a 1-byte write (stretch: keep the bus for a repeated START) or a 1-byte read.
+ * 0 done, 1 NACK, 2 other error, 3 engine stuck (stop using SE1).
+ */
+static int
+amp_msg(vm_offset_t se, uint8_t addr, bool read, uint8_t *byte)
+{
+	if (!amp_wait_clear(se, SE_STATUS, 1u)) {
+		return 3;
+	}
+	amp_wr(se, SE_IRQ_CLR, 0xffffffffu);
+	amp_wr(se, SE_TX_WM, read ? 0u : 1u);
+	amp_wr(se, read ? SE_RX_LEN : SE_TX_LEN, 1u);
+	amp_wr(se, SE_CMD, ((read ? 2u : 1u) << 27) | ((uint32_t)addr << 9) | (read ? 0u : 4u));
+	bool sent = read, got = !read;
+	for (unsigned i = 0; i < 5000; i++) {
+		uint32_t irq = amp_rd(se, SE_IRQ);
+		if (irq & SE_ERRORS) {
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); j++) {
+				delay(1);
+				irq = amp_rd(se, SE_IRQ);
+			}
+			int err = (irq & SE_NACK) ? 1 : 2;
+			if ((irq & SE_DONE) && !(amp_rd(se, SE_STATUS) & 1u)) {
+				amp_wr(se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			return amp_abort(se) ? err : 3;
+		}
+		if (!sent && (irq & SE_TX_WM_IRQ)) {
+			amp_wr(se, SE_TX, *byte);
+			amp_wr(se, SE_TX_WM, 0);
+			sent = true;
+		}
+		if (!got && (amp_rd(se, SE_RX_COUNT) & 0x1ffffffu)) {
+			*byte = (uint8_t)amp_rd(se, SE_RX);
+			got = true;
+		}
+		if (irq & SE_DONE) {
+			amp_wr(se, SE_IRQ_CLR, irq);
+			return sent && got ? 0 : 2;
+		}
+		amp_wr(se, SE_IRQ_CLR, irq & (SE_TX_WM_IRQ | (3u << 26)));
+		delay(1);
+	}
+	return amp_abort(se) ? 2 : 3;
+}
+
+/* Register reg of the chip at addr: write the pointer, then read one byte. */
+static int
+amp_read(vm_offset_t se, uint8_t addr, uint8_t reg, uint8_t *val)
+{
+	int err = amp_msg(se, addr, false, &reg);
+	return err != 0 ? err : amp_msg(se, addr, true, val);
+}
