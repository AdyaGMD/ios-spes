+/* DCS 0x51 display brightness, two bytes MSB first (DT bl-inverted-dbv). */
+void
+AppleCLCD::setPanelLevel(uint32_t level)
+{
+	uint8_t hdr[4] = { 3, 0, 0x39, 0xc0 };                      /* long write, last|long */
+	uint8_t cmd[3] = { 0x51, (uint8_t)(level >> 8), (uint8_t)level };
+	IOLockLock(fDsiLock);
+	bool done = dsiSend(hdr, cmd, sizeof(cmd));
+	IOLockUnlock(fDsiLock);
+	static uint32_t logs;
+	if (logs++ < 8 || !done) {
+		IOLog("SWEET FB: panel level %#x: %s\n", level, done ? "done" : "NO DONE");
+	}
+}
+
+/*
+ * Panel power as the Linux panel drivers do it (Topaz 0143): off = brightness 0, DCS 0x28
+ * display off, 0x10 sleep in; on = 0x11 sleep out, 120 ms, 0x29 display on, brightness back.
+ */
+void
+AppleCLCD::setPanelOn(bool on)
+{
+	uint8_t first[4] = { (uint8_t)(on ? 0x11 : 0x28), 0, 0x05, 0x80 };      /* short write, last */
+	uint8_t second[4] = { (uint8_t)(on ? 0x29 : 0x10), 0, 0x05, 0x80 };
+	bool done = true;
+	if (!on) {
+		setPanelLevel(0);
+	}
+	IOLockLock(fDsiLock);
+	done &= dsiSend(first, NULL, 0);
+	IOLockUnlock(fDsiLock);
+	IOSleep(on ? 120 : 20);
+	IOLockLock(fDsiLock);
+	done &= dsiSend(second, NULL, 0);
+	IOLockUnlock(fDsiLock);
+	if (on) {
+		setPanelLevel(fPanelLevel);
+	} else {
+		IOSleep(120);
+	}
+	IOLog("SWEET FB: panel %s: %s\n", on ? "sleep out, display on" : "display off, sleep in",
+	    done ? "done" : "NO DONE");
+}
+
+/*
+ * CoreBrightness sets IOMFBBrightnessLevel on the framebuffer: nits in 16.16 (Topaz 0104).
+ * 0..500 nits -> DCS level 1..0x7ff, sent unless the display is off.
+ */
+IOReturn
+AppleCLCD::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	OSNumber *n = d != NULL ? OSDynamicCast(OSNumber, d->getObject("IOMFBBrightnessLevel")) : NULL;
+	if (n == NULL || fDsi == NULL) {
+		return kIOReturnUnsupported;
+	}
+	uint64_t v = n->unsigned64BitValue();
+	setProperty("IOMFBBrightnessLevel", v, 32);
+	uint64_t level = (v * 0x7ffull) / (500ull << 16);
+	level = level > 0x7ff ? 0x7ff : (level < 1 ? 1 : level);
+	IOLockLock(fLock);
+	fPanelLevel = (uint32_t)level;
+	bool off = fPowerOff;
+	IOLockUnlock(fLock);
+	if (!off) {
+		setPanelLevel((uint32_t)level);
+	}
+	return kIOReturnSuccess;
+}
