+/* DSI0 controller access (Topaz 0104), with a barrier around every write. */
+static inline uint32_t sweet_dsi_rd(volatile uint8_t *b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline void
+sweet_dsi_wr(volatile uint8_t *b, uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * One DSI packet through the command DMA path (Topaz 0104/0143): header + payload in a
+ * contiguous buffer, low-power mode (as Linux sends to MIPI_DSI_MODE_LPM panels; Topaz's
+ * panel took nothing in high speed), software trigger, wait for CMD_DMA_DONE. Caller holds
+ * fDsiLock.
+ */
 bool
+AppleCLCD::dsiSend(const uint8_t hdr[4], const uint8_t *payload, uint32_t len)
+{
+	if (fDsi == NULL || len > 60) {
+		return false;
+	}
+	uint8_t *p = (uint8_t *)fDsiBuf->getBytesNoCopy();
+	uint32_t size = (4 + len + 3) & ~3u;
+	memset(p, 0xff, 64);
+	memcpy(p, hdr, 4);
+	if (len) {
+		memcpy(p + 4, payload, len);
+	}
+	for (uintptr_t line = (uintptr_t)p & ~(uintptr_t)63; line < (uintptr_t)p + 64; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t ctrl = sweet_dsi_rd(fDsi, 0x004), trig = sweet_dsi_rd(fDsi, 0x084);
+	if ((trig & 7) != 4) {
+		sweet_dsi_wr(fDsi, 0x084, (trig & ~7u) | 4);       /* DMA trigger: software */
+	}
+	sweet_dsi_wr(fDsi, 0x004, ctrl | 4 | 1);                   /* CMD_MODE_EN | DSI_EN */
+	sweet_dsi_wr(fDsi, 0x110, sweet_dsi_rd(fDsi, 0x110) | 1);  /* clear CMD_DMA_DONE */
+	sweet_dsi_wr(fDsi, 0x15c, 0);                              /* no test pattern */
+	sweet_dsi_wr(fDsi, 0x048, (uint32_t)fDsiBufPhys);
+	sweet_dsi_wr(fDsi, 0x04c, size);
+	uint32_t dma = sweet_dsi_rd(fDsi, 0x03c);
+	sweet_dsi_wr(fDsi, 0x03c, dma | (1u << 26));               /* low-power mode */
+	sweet_dsi_wr(fDsi, 0x090, 1);                              /* software trigger */
+	bool done = false;
+	for (int i = 0; i < 50 && !done; i++) {
+		done = (sweet_dsi_rd(fDsi, 0x110) & 1) != 0;
+		if (!done) {
+			IODelay(1000);
+		}
+	}
+	if (!done) {
+		static uint32_t told;
+		if (told++ < 6) {
+			IOLog("SWEET FB: DSI cmd %#x not done: ctrl %#x trig %#x dma %#x int %#x status %#x err %#x\n",
+			    hdr[0], sweet_dsi_rd(fDsi, 0x004), sweet_dsi_rd(fDsi, 0x084), sweet_dsi_rd(fDsi, 0x03c),
+			    sweet_dsi_rd(fDsi, 0x110), sweet_dsi_rd(fDsi, 0x008), sweet_dsi_rd(fDsi, 0x0c4));
+		}
+	}
+	sweet_dsi_wr(fDsi, 0x110, sweet_dsi_rd(fDsi, 0x110) | 1);
+	sweet_dsi_wr(fDsi, 0x03c, dma);
+	sweet_dsi_wr(fDsi, 0x004, ctrl);
+	if (trig != sweet_dsi_rd(fDsi, 0x084)) {
+		sweet_dsi_wr(fDsi, 0x084, trig);
+	}
+	return done;
+}
