+/* Called before RAM-backed init; never mounts or writes the Android volume. */
+void spes_ufs_probe(void);
+
+void
+spes_ufs_probe(void)
+{
+	DTEntry platform;
+	int enabled = 0;
+	char root[32] = { 0 };
+	(void)PE_parse_boot_argn("spesufsprobe", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("rd", root, sizeof(root));
+	if (enabled != 1 ||
+	    SecureDTLookupEntry(NULL, "/spes-platform", &platform) != kSuccess) {
+		return;
+	}
+	if (strcmp(root, "md0") != 0 || su.ready) {
+		printf("SPES UFS PROBE: refused; requires unused UFS and rd=md0\n");
+		return;
+	}
+	spes_readonly_probe = true;
+	printf("SPES UFS PROBE: starting, disk writes blocked\n");
+	int error = sweet_ufs_init();
+	printf("SPES UFS PROBE: result=%d; continuing RAM init\n", error);
+}
