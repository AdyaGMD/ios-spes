+/* The probe owns L1[0:1]. Allocate two contiguous 4K L2 tables in one
+ * kernel page; install them only into previously empty root entries. */
+static bool spes_gpu_address_space(uint64_t *l1) {
+ if (!l1 || l1[2] || l1[3]) return false;
+ vm_offset_t memory=0;
+ if(kmem_alloc_contig(kernel_map,&memory,PAGE_SIZE,PAGE_MASK,0,0,
+     KMA_DATA|KMA_ZERO|KMA_PERMANENT,VM_KERN_MEMORY_IOKIT)!=KERN_SUCCESS)return false;
+ uint64_t physical=ptoa_64(pmap_find_phys(kernel_pmap,(addr64_t)memory));
+ if(!physical || physical>((1ull<<36)-PAGE_SIZE) || (physical&4095))return false;
+ memset((void *)memory,0,PAGE_SIZE);
+ to_memory(memory,PAGE_SIZE);
+ sg.l2=(uint64_t *)memory;
+ l1[2]=physical|3ull;
+ l1[3]=(physical+4096)|3ull;
+ to_memory((vm_offset_t)&l1[2],16);
+ return true;
+}
