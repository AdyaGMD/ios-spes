-#define SPES_GPU_BASE 0x20000000ull
-/* 512 MiB, L2 entries 256-511 of the first GiB: 256 MiB ran out of runs for 13.9 MB screen
- * surfaces once the faster CPU kept more of them alive (all11: "no addresses left"). */
-#define SPES_GPU_SIZE 0x20000000ull
+/* Dedicated L1 entries 2 and 3: 2 GiB of GPU virtual addresses, not reserved RAM.
+ * Keep probe firmware/ring/target/framebuffer mappings in L1[0:1] untouched.
+ * All addresses remain below 4 GiB, including the final byte of the pool. */
+#define SPES_GPU_BASE 0x80000000ull
+#define SPES_GPU_SIZE 0x80000000ull
 #define SPES_GPU_GRANULE 0x10000ull
 #define SPES_GPU_GRANULES (SPES_GPU_SIZE / SPES_GPU_GRANULE)
 #define SPES_GPU_TABLES (SPES_GPU_SIZE >> 21)
