Video and sound fixes from all29: DisplayPipePlaneBaseAlignment as a dictionary; /dev/redwood-audio
created once devfs exists.

all29: mediaserverd died whenever a video played: "-[__NSCFNumber objectForKey:]" in
FigGetAlignmentForIOSurfaceOutputToDisplayService (VideoToolbox), which reads
PlaneBaseAlignmentLinear out of AppleCLCD's DisplayPipePlaneBaseAlignment; we published a number.
And SpesAudio logged "/dev/redwood-audio: not created" at spes_audio_init (no devfs yet), so the
RedwoodAudio plug-in found no device ("No such file or directory"). The audio thread now retries
every 100 ms (up to 60 s) before it boots the ADSP.

--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -382,7 +382,19 @@
 	/* For EAGL (HackiOS eagl.c display_waits()): swaps wait for the GPU, so frames need not be finished first. */
 	setProperty("RedwoodWaitsForGPU", kOSBooleanTrue);
 	setProperty("external", false);
-	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
+	/*
+	 * A dictionary, as on the iPhone: VideoToolbox (FigGetAlignmentForIOSurfaceOutputToDisplayService)
+	 * reads PlaneBaseAlignmentLinear from it with CFDictionaryGetValue; the plain number we had
+	 * made mediaserverd die on "-[__NSCFNumber objectForKey:]" as soon as a video played (all29).
+	 */
+	OSDictionary *align = OSDictionary::withCapacity(1);
+	OSNumber *linear = OSNumber::withNumber(64ULL, 32);
+	if (align != NULL && linear != NULL) {
+		align->setObject("PlaneBaseAlignmentLinear", linear);
+		setProperty("DisplayPipePlaneBaseAlignment", align);
+	}
+	OSSafeReleaseNULL(linear);
+	OSSafeReleaseNULL(align);
 	registerService();
 	uint32_t accelOn = 1;
 	(void)PE_parse_boot_argn("sweetaccel", &accelOn, sizeof(accelOn));
