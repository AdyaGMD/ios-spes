 };
 
-/* At spes_audio_init: the plug-in opens the node once, when mediaserverd loads it, maybe before the DSP is up. */
+/*
+ * The plug-in opens the node once, when mediaserverd loads it, maybe before the DSP is up. At
+ * spes_audio_init devfs is not there yet ("not created", all29: the plug-in found no device), so
+ * the audio thread tries again every 100 ms until it is, long before launchd starts mediaserverd.
+ */
+static int ra_major = -1;
+static bool ra_node;
+
 static void
 audio_dev_init(void)
 {
-	int major = cdevsw_add(-1, &ra_cdevsw);
-	void *node = major < 0 ? NULL :
-	    devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-audio");
-	LOG("/dev/redwood-audio: %s", node != NULL ? "ready (frames dropped until the stream is open)" : "not created");
+	static unsigned tries;
+	if (ra_node) {
+		return;
+	}
+	if (ra_major < 0) {
+		ra_major = cdevsw_add(-1, &ra_cdevsw);
+		if (ra_major < 0) {
+			ra_node = true;         /* no major: nothing to try again */
+			LOG("/dev/redwood-audio: no major");
+			return;
+		}
+	}
+	tries++;
+	ra_node = devfs_make_node(makedev(ra_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-audio") != NULL;
+	if (ra_node) {
+		LOG("/dev/redwood-audio: ready after %u tries (frames dropped until the stream is open)", tries);
+	}
 }
 
