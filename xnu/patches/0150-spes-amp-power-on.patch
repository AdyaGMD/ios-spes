-amp_msg(vm_offset_t se, uint8_t addr, bool read, uint8_t *byte)
+amp_xfer(vm_offset_t se, uint8_t addr, bool read, uint8_t *byte, uint32_t len, bool stretch)
 {
 	if (!amp_wait_clear(se, SE_STATUS, 1u)) {
 		return 3;
 	}
 	amp_wr(se, SE_IRQ_CLR, 0xffffffffu);
 	amp_wr(se, SE_TX_WM, read ? 0u : 1u);
-	amp_wr(se, read ? SE_RX_LEN : SE_TX_LEN, 1u);
-	amp_wr(se, SE_CMD, ((read ? 2u : 1u) << 27) | ((uint32_t)addr << 9) | (read ? 0u : 4u));
+	amp_wr(se, read ? SE_RX_LEN : SE_TX_LEN, read ? 1u : len);
+	amp_wr(se, SE_CMD, ((read ? 2u : 1u) << 27) | ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
 	bool sent = read, got = !read;
 	for (unsigned i = 0; i < 5000; i++) {
 		uint32_t irq = amp_rd(se, SE_IRQ);
@@ -262,7 +263,7 @@
 			return amp_abort(se) ? err : 3;
 		}
 		if (!sent && (irq & SE_TX_WM_IRQ)) {
-			amp_wr(se, SE_TX, *byte);
+			amp_wr(se, SE_TX, len == 2 ? (uint32_t)byte[0] | ((uint32_t)byte[1] << 8) : *byte);
 			amp_wr(se, SE_TX_WM, 0);
