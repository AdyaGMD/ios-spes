+}
+
+static int
+amp_msg(vm_offset_t se, uint8_t addr, bool read, uint8_t *byte)
+{
+	return amp_xfer(se, addr, read, byte, 1, !read);
 }
 
 /* Register reg of the chip at addr: write the pointer, then read one byte. */
@@ -286,13 +293,47 @@
 {
 	int err = amp_msg(se, addr, false, &reg);
 	return err != 0 ? err : amp_msg(se, addr, true, val);
+}
+
+static int
+amp_write(vm_offset_t se, uint8_t addr, uint8_t reg, uint8_t val)
+{
+	uint8_t b[2] = { reg, val };
+	return amp_xfer(se, addr, false, b, 2, false);
+}
+
+/*
+ * spesamp=2: switch an aw87559 (id 0x5a) on after its reset pulse. Stock Linux loads the register
+ * profile from aw87xxx_acf.bin, which we do not have; the chip's reset values already have the
+ * charge pump, boost and PA enabled (SYSCTRL 0x38, aw87xxx_pid_5a_reg.h), with EN_SW (bit 6) the
+ * master switch off and the PA gain at 0x10 (24 dB). So: gain first (spesampgain, default 6 =
+ * 9 dB, low), then SYSCTRL 0x78. The amplifier stays on: the codec's AUX output is its input,
+ * silent until something plays.
+ */
+static void
+amp_power_on(vm_offset_t se, uint8_t addr)
+{
+	int gain = 6;
+	PE_parse_boot_argn("spesampgain", &gain, sizeof(gain));
+	if (gain < 0 || gain > 0x10) {
+		gain = 6;
+	}
+	uint8_t sys = 0, st = 0, pagr = 0;
+	(void)amp_read(se, addr, 0x01, &sys);
+	int e1 = amp_write(se, addr, 0x06, (uint8_t)gain);
+	int e2 = amp_write(se, addr, 0x01, 0x78);
+	delay(5000);
+	(void)amp_read(se, addr, 0x01, &sys);
+	(void)amp_read(se, addr, 0x06, &pagr);
+	(void)amp_read(se, addr, 0x58, &st);
+	printf("SPES AMP: %#x on: writes %d/%d, sysctrl %#x gain %#x sysst %#x\n", addr, e1, e2, sys, pagr, st);
 }
 
