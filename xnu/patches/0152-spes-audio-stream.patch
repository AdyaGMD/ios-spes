+	if (st_vol_db > 0 || st_vol_db < -84) {
+		st_vol_db = -12;
+	}
+	fifo = (uint8_t *)IOMalloc(FIFO_BYTES);
+	fifo_lock = IOLockAlloc();
+	if (fifo == NULL || fifo_lock == NULL || !s3_open()) {
+		LOG("t=%u.%03u stream: not opened", T);
+		return;
+	}
+	st_ready = true;
+	LOG("t=%u.%03u stream: open, waiting for /dev/redwood-audio (spesvol %d dB)", T, st_vol_db);
+}
+
+static void
+stream_start(void)
+{
+	if (!st_ran) {
+		if (!s3_run()) {
+			LOG("t=%u.%03u stream: run failed: no sound this boot", T);
+			st_ready = false;
+			return;
+		}
+		st_ran = true;
+	}
+	if (!st_ports_up) {
+		s3_ports();
+		st_ports_up = true;
+	}
+	s3_done = s3_underflows = s3_errors = 0;
+	s3_rx2(true, st_db());
+	vol_applied = vol_gen;
+	for (uint32_t p = 0; p < ST_INFLIGHT; p++) {
+		if (!(st_busy & (1u << p))) {
+			st_fill(p);
+		}
+	}
+	st_playing = true;
+	LOG("t=%u.%03u stream: playing at %d dB", T, st_db());
+}
+
+static void
+stream_stop(void)
+{
+	st_playing = false;
+	cdc_w(CDC_RX_MACRO + 0x514, (uint32_t)(int8_t)-84 & 0xFF);     /* mute first: no click */
+	IOSleep(30);
+	s3_rx2(false, -84);
+	st_last_write = 0;
+	LOG("t=%u.%03u stream: stopped: %llu frames in, %llu dropped (FIFO full), %llu skipped (ahead), %llu periods sent, "
+	    "%u done, %u short, %u errors, %u underflows", T, st_in, st_dropped, st_skipped, st_sent, s3_done, (unsigned)st_short,
+	    s3_errors, s3_underflows);
+}
