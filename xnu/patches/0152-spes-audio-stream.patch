+/* the audio thread, between GLINK polls: start, refill, volume, stop */
+static void
+stream_poll(void)
+{
+	if (!st_ready) {
+		return;
+	}
+	uint32_t back = s3_returned;
+	if (back != 0) {
+		s3_returned &= ~back;
+		st_busy &= ~back;
+	}
+	uint32_t last = st_last_write;
+	bool fresh = last != 0 && ms() - last < ST_QUIET_MS;
+	if (!st_playing) {
+		if (fresh) {
+			stream_start();
+		}
+		return;
+	}
+	for (uint32_t p = 0; p < ST_INFLIGHT; p++) {
+		if ((back & (1u << p)) && !(st_busy & (1u << p))) {
+			st_fill(p);
+		}
+	}
+	if (vol_applied != vol_gen) {
+		vol_applied = vol_gen;
+		cdc_w(CDC_RX_MACRO + 0x514, (uint32_t)(int8_t)st_db() & 0xFF);
+		LOG("t=%u.%03u stream: volume %d dB", T, st_db());
+	}
+	if (!fresh) {
+		stream_stop();
+	}
 }
 
+/* frames from /dev/redwood-audio: never waits; how many were taken */
+static uint32_t
+stream_write(const int16_t *frames, uint32_t count)
+{
+	if (!st_ready) {
+		return 0;
+	}
+	uint32_t bytes = count * 4;
+	IOLockLock(fifo_lock);
+	uint32_t room = FIFO_BYTES - (fifo_w - fifo_r);
+	if (bytes > room) {
+		st_dropped += (bytes - room) / 4;
+		bytes = room;
+	}
+	uint32_t at = fifo_w % FIFO_BYTES, n1 = MIN(bytes, FIFO_BYTES - at);
+	memcpy(fifo + at, frames, n1);
+	memcpy(fifo, (const uint8_t *)frames + n1, bytes - n1);
+	fifo_w += bytes;
+	st_in += bytes / 4;
+	uint32_t now = ms();
+	st_last_write = now != 0 ? now : 1;
+	IOLockUnlock(fifo_lock);
+	return bytes / 4;
+}
+
+/* ---------------------------------------------------------------- /dev/redwood-audio */
+
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/ioccom.h>
+#include <miscfs/devfs/devfs.h>
+
+struct redwood_audio_volume_arg { uint32_t below, muted; };
+#define REDWOOD_AUDIO_SET_VOLUME  _IOW('r', 1, struct redwood_audio_volume_arg)
+
+static int
+ra_open(dev_t, int, int, struct proc *)
+{
+	return 0;
+}
+
+static int
+ra_close(dev_t, int, int, struct proc *)
+{
+	return 0;
+}
+
+static int
+ra_write(dev_t, struct uio *uio, int)
+{
+	int16_t buf[1024 * 2];
+
+	while (uio_resid(uio) >= 4) {
+		user_ssize_t n = MIN(uio_resid(uio), (user_ssize_t)sizeof(buf)) & ~3;
+		int err = uiomove((char *)buf, (int)n, uio);
+		if (err != 0) {
+			return err;
+		}
+		(void)stream_write(buf, (uint32_t)(n / 4));
+	}
+	return 0;
+}
+
+static int
+ra_ioctl(dev_t, u_long cmd, caddr_t data, int, struct proc *)
+{
+	if (cmd != REDWOOD_AUDIO_SET_VOLUME) {
+		return ENOTTY;
+	}
+	const struct redwood_audio_volume_arg *v = (const struct redwood_audio_volume_arg *)data;
+	vol_below = v->below;
+	vol_muted = v->muted;
+	vol_gen++;
+	return 0;
+}
+
+static const struct cdevsw ra_cdevsw = {
+	.d_open = ra_open, .d_close = ra_close, .d_read = eno_rdwrt, .d_write = ra_write, .d_ioctl = ra_ioctl,
+	.d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = eno_select, .d_mmap = eno_mmap,
+	.d_strategy = eno_strat, .d_reserved_1 = eno_getc, .d_reserved_2 = eno_putc, .d_type = 0,
+};
+
+/* At spes_audio_init: the plug-in opens the node once, when mediaserverd loads it, maybe before the DSP is up. */
 static void
+audio_dev_init(void)
+{
+	int major = cdevsw_add(-1, &ra_cdevsw);
+	void *node = major < 0 ? NULL :
+	    devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-audio");
+	LOG("/dev/redwood-audio: %s", node != NULL ? "ready (frames dropped until the stream is open)" : "not created");
+}
