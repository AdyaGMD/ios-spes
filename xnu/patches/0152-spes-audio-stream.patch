+/* ---------------------------------------------------------------- the stream iOS plays into */
+
+/*
+ * spescodec=4: Topaz's 0146 on spes's APR path. The stream of stage 3 is opened once and stays
+ * open; /dev/redwood-audio (HackiOS's RedwoodAudio.driver HAL plug-in in mediaserverd writes
+ * whole 48 kHz 16-bit stereo frames, ioctl _IOW('r', 1, {below, muted}) the volume) puts frames
+ * into a 1 s FIFO and never waits. When frames come the audio thread runs the session (once),
+ * sets up the ports (once), turns RX2's path on and keeps ST_INFLIGHT periods with the DSP,
+ * each refilled from the FIFO (silence where it runs short) as the DSP gives it back. 0.5 s after
+ * the last write it stops refilling, mutes and turns RX2's path off; the periods still with the
+ * DSP are silence by then. The amplifiers stay on (spes_amp.c, spesamp=2). Volume: RX2's
+ * digital gain, boot-arg spesvol (dB, default -12) at iOS's loudest.
+ */
+#define FIFO_BYTES          (48000u * 4)
+#define ST_INFLIGHT         6u                      /* 6 x 21.3 ms with the DSP */
+#define ST_QUIET_MS         500u
+
+static uint8_t *fifo;
+static uint32_t fifo_r, fifo_w;                     /* bytes read and written, ever (mod 2^32) */
+static IOLock *fifo_lock;
+static volatile bool st_ready;
+static volatile uint32_t st_last_write;             /* ms() of the latest write, 0: none since the stop */
+static bool st_playing, st_ran, st_ports_up;
+static uint32_t st_busy;                            /* periods with the DSP */
+static int st_vol_db = -12;
+static volatile uint32_t vol_below, vol_muted, vol_gen;
+static uint32_t vol_applied;
+static uint64_t st_in, st_dropped, st_skipped, st_short, st_sent;
+
+static int
+st_db(void)
+{
+	int db = vol_muted ? -84 : st_vol_db - (int)(vol_below / 8);
+	return db < -84 ? -84 : db;
+}
+
+static void
+st_fill(uint32_t p)
+{
+	uint8_t *dst = s3_buf + p * S3_PERIOD_BYTES;
+	IOLockLock(fifo_lock);
+	uint32_t held = fifo_w - fifo_r;
+	if (held > FIFO_BYTES / 4) {                    /* the writer ran ahead of the DSP's clock: keep 100 ms */
+		uint32_t skip = (held - FIFO_BYTES / 10) & ~3u;
+		fifo_r += skip;
+		held -= skip;
+		st_skipped += skip / 4;
 	}
-	s3_call("buffer unmapped", APR_SVC_ASM, 0, 0x00010d94u, &handle, sizeof(handle), 0x00010d94u);
+	uint32_t n = MIN(held, S3_PERIOD_BYTES), at = fifo_r % FIFO_BYTES, n1 = MIN(n, FIFO_BYTES - at);
+	memcpy(dst, fifo + at, n1);
+	memcpy(dst + n1, fifo, n - n1);
+	fifo_r += n;
+	IOLockUnlock(fifo_lock);
+	if (n < S3_PERIOD_BYTES) {
+		bzero(dst + n, S3_PERIOD_BYTES - n);
+		if (n != 0) {
+			st_short++;
+		}
+	}
+	for (uintptr_t l = (uintptr_t)dst; l < (uintptr_t)dst + S3_PERIOD_BYTES; l += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (l));
