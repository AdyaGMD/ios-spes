+/// Explicit host-pointer image layouts do not require Linux dma-buf imports.
+/// Vulkan 1.2 provides the modifier extension's dependencies.
+pub(crate) fn host_modifier_name(listed: &BTreeSet<CString>) -> Option<&'static CStr> {
+    let name = ash::ext::image_drm_format_modifier::NAME;
+    listed.contains(name).then_some(name)
+}
