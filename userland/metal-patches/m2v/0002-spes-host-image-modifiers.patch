+#[test]
+fn host_modifiers_do_not_require_linux_dma_buf_extensions() {
+    use crate::device::create::host_modifier_name;
+    let mut listed = BTreeSet::<CString>::new();
+    assert!(host_modifier_name(&listed).is_none());
+    listed.insert(c"VK_EXT_image_drm_format_modifier".to_owned());
+    assert!(host_modifier_name(&listed).is_some());
+    assert!(dma_buf_names(&listed).is_none());
+    assert!(dma_buf_image_names(&listed).is_none());
+    listed.insert(c"VK_EXT_queue_family_foreign".to_owned());
+    assert!(host_modifier_name(&listed).is_some());
+    assert!(dma_buf_image_names(&listed).is_none());
+    for name in DMA_BUF { listed.insert(name.to_owned()); }
+    assert!(dma_buf_image_names(&listed).is_some());
 }
 
